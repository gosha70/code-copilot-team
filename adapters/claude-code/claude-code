# A template folder holding this file is an add-on (ui-harness): installed
# beside the project templates, listed apart from them, refused by init.
# Defined here, among the functions, so suites that load only the function
# region (tests/test-sync.sh) see it too.
ADDON_MARKER=".cct-addon"

list_templates() {
    echo "Available project templates:"
    echo ""
    local addons=""
    if [[ -d "$TEMPLATES_DIR" ]]; then
        for dir in "$TEMPLATES_DIR"/*/; do
            if [[ -f "$dir/CLAUDE.md" ]]; then
                type_name=$(basename "$dir")
                # Extract first line after "# " as description
                desc=$(head -1 "$dir/CLAUDE.md" | sed 's/^# //')
                if [[ -f "$dir/$ADDON_MARKER" ]]; then
                    addons+="$(printf "  %-20s %s" "$type_name" "$desc")"$'\n'
                    continue
                fi
                printf "  %-20s %s\n" "$type_name" "$desc"
            fi
        done
        if [[ -n "$addons" ]]; then
            echo ""
            echo "Available add-ons (copy one into an existing project; init does not take them):"
            echo ""
            printf "%s" "$addons"
        fi
    else
        echo "  No templates found. Run ./scripts/setup.sh --claude-code from your checkout first."
    fi
    echo ""
}

# print_addon_refusal <name> — why init will not start a project from an
# add-on, with the copy steps its own instructions give (the first code block
# under "Scaffold it into a project" in its installed CLAUDE.md), so the steps
# are never restated here.
print_addon_refusal() {
    local name="$1" doc="$TEMPLATES_DIR/$1/CLAUDE.md" steps
    echo "Error: '$name' is an add-on, not a project type; init does not start a project from it."
    steps=$(awk '/^## Scaffold it into a project/ { s = 1; next }
                 s && /^```/ { if (b) exit; b = 1; next }
                 s && b { print "  " $0 }' "$doc" 2>/dev/null || true)
    if [[ -n "$steps" ]]; then
        echo "Copy it into an existing project instead. From that project's root:"
        echo ""
        printf '%s\n' "$steps"
    fi
    echo ""
    echo "Its instructions: $doc"
}

print_relaxed_warning() {
    echo ""
    echo "  ⚠️  RELAXED (dangerous) permission tier"
    echo "  ─────────────────────────────────────────────────────────────"
    echo "  This DISARMS the safety hooks for this project:"
    echo "    • HOOK_GIT_ALLOW=true      — commits and pushes run WITHOUT chat approval"
    echo "    • HOOK_PROTECT_ALLOW=true  — edits to .env / credentials / keys are ALLOWED"
    echo "  The Bash deny guardrails (rm -rf, sudo, push --force, reset --hard)"
    echo "  are kept, and bypassPermissions is NEVER used — but this is still"
    echo "  fully autonomous. Only choose this for a project you fully trust."
    echo "  ─────────────────────────────────────────────────────────────"
}

# confirm_relaxed <yes_dangerous> — 0 if OK to write the relaxed profile, 1 if
# refused. --yes-dangerous (1) skips the prompt; otherwise an interactive y/N
# is required and the write is refused when there is no TTY.
confirm_relaxed() {
    local yes="${1:-0}"
    [[ "$yes" == "1" ]] && return 0
    print_relaxed_warning
    if [[ -t 0 ]]; then
        local REPLY
        read -p "  Proceed writing the relaxed profile? [y/N] " -n 1 -r REPLY || true
        echo
        [[ "$REPLY" =~ ^[Yy]$ ]] && return 0
        echo "Aborted — relaxed profile not written."
        return 1
    fi
    echo "Refusing to write 'relaxed' without --yes-dangerous (no TTY to confirm)."
    return 1
}

# preflight_permission_tier <tier> — validate an EXPLICITLY chosen tier (and
# confirm 'relaxed') BEFORE init creates any files, so init never reports
# success with the wrong or missing safety boundary. No-op for 'default'.
# Sets YES_DANGEROUS=1 once a relaxed choice is confirmed. Returns nonzero to
# abort init before anything is written.
preflight_permission_tier() {
    local tier="$1"
    [[ "$tier" == "default" ]] && return 0
    case "$tier" in
        balanced|relaxed) ;;
        *) echo "Error: unknown permission tier '$tier' (expected default|balanced|relaxed)."; return 1 ;;
    esac
    if [[ ! -f "$PERMISSIONS_DIR/$tier.json" ]]; then
        echo "Error: permission profile '$tier' not found at $PERMISSIONS_DIR/$tier.json."
        echo "       Run ./scripts/setup.sh --sync --claude-code from your checkout to install permission profiles."
        return 1
    fi
    if ! command_exists jq; then
        echo "Error: jq is required to apply the '$tier' permission profile."
        return 1
    fi
    if [[ "$tier" == "relaxed" ]]; then
        confirm_relaxed "$YES_DANGEROUS" || return 1
        YES_DANGEROUS=1
    fi
    return 0
}

# apply_permission_profile <target> <tier> <template_type> [yes_dangerous]
# Merges a permission profile (+ per-type deny-extras) into
# $target/.claude/settings.json via jq — never clobbering existing keys,
# idempotent — and records the tier in template.json. 'default' writes
# nothing. 'relaxed' requires explicit confirmation (--yes-dangerous or an
# interactive y/N). Returns non-zero (writing nothing) on refusal or error.
apply_permission_profile() {
    local target="$1" tier="$2" type="${3:-}" yes="${4:-0}"

    if [[ "$tier" == "default" ]]; then
        # Still record the choice so sync/drift knows the tier.
        _record_permission_tier "$target" "default"
        return 0
    fi

    case "$tier" in
        balanced|relaxed) ;;
        *) echo "Error: unknown permission tier '$tier' (expected default|balanced|relaxed)."; return 1 ;;
    esac
    local prof="$PERMISSIONS_DIR/$tier.json"
    if [[ ! -f "$prof" ]]; then
        echo "Error: permission profile '$tier' not found at $prof."
        echo "       Run ./scripts/setup.sh --sync --claude-code from your checkout to install permission profiles."
        return 1
    fi

    if [[ "$tier" == "relaxed" ]]; then
        confirm_relaxed "$yes" || return 1
    fi

    if ! command_exists jq; then
        echo "[WARN] jq not installed — cannot write permission profile. Apply manually from $prof."
        return 1
    fi

    mkdir -p "$target/.claude"
    local settings="$target/.claude/settings.json"
    [[ -f "$settings" ]] || echo '{}' > "$settings"

    local extras_arg='{}'
    local extras="$PERMISSIONS_DIR/deny-extras/$type.json"
    if [[ -n "$type" && -f "$extras" ]]; then
        extras_arg=$(cat "$extras")
    fi

    local merged
    merged=$(jq --slurpfile p "$prof" --argjson x "$extras_arg" '
        .permissions.defaultMode = $p[0].permissions.defaultMode
        | .permissions.allow = (((.permissions.allow // []) + ($p[0].permissions.allow // [])) | unique)
        | .permissions.deny  = (((.permissions.deny  // []) + ($p[0].permissions.deny  // []) + ($x.permissions.deny // [])) | unique)
        | if (($p[0].env // {}) | length) > 0 then .env = ((.env // {}) + $p[0].env) else . end
    ' "$settings") || { echo "[WARN] failed to merge permission profile into settings.json."; return 1; }
    printf '%s\n' "$merged" > "$settings"

    _record_permission_tier "$target" "$tier"
    echo "[done] Applied '$tier' permission profile to .claude/settings.json"
    return 0
}

# strip_permission_profile <target> — remove the profile-managed keys
# (defaultMode, managed allow/deny entries, relaxed env vars) while preserving
# any user-added settings.json content. Used by 'permissions default'.
strip_permission_profile() {
    local target="$1"
    local settings="$target/.claude/settings.json"

    if [[ ! -f "$settings" ]]; then
        _record_permission_tier "$target" "default"
        echo "[done] No managed settings.json — tier set to default."
        return 0
    fi
    if ! command_exists jq; then
        echo "[WARN] jq not installed — cannot strip permission profile."
        return 1
    fi

    # Managed entries = union across shipped profiles + deny-extras. User-added
    # allow/deny entries not present in any shipped profile survive.
    local managed_allow managed_deny
    managed_allow=$(cat "$PERMISSIONS_DIR"/balanced.json "$PERMISSIONS_DIR"/relaxed.json 2>/dev/null \
        | jq -s '[.[].permissions.allow // [] | .[]] | unique')
    managed_deny=$(cat "$PERMISSIONS_DIR"/balanced.json "$PERMISSIONS_DIR"/relaxed.json "$PERMISSIONS_DIR"/deny-extras/*.json 2>/dev/null \
        | jq -s '[.[].permissions.deny // [] | .[]] | unique')
    [[ -n "$managed_allow" ]] || managed_allow='[]'
    [[ -n "$managed_deny" ]]  || managed_deny='[]'

    local stripped
    stripped=$(jq --argjson ma "$managed_allow" --argjson md "$managed_deny" '
        del(.permissions.defaultMode)
        | if (.permissions.allow != null) then .permissions.allow = (.permissions.allow - $ma)
            | (if ((.permissions.allow | length) == 0) then del(.permissions.allow) else . end) else . end
        | if (.permissions.deny != null) then .permissions.deny = (.permissions.deny - $md)
            | (if ((.permissions.deny | length) == 0) then del(.permissions.deny) else . end) else . end
        | if ((.permissions // {}) | length) == 0 then del(.permissions) else . end
        | if (.env != null) then del(.env.HOOK_GIT_ALLOW) | del(.env.HOOK_PROTECT_ALLOW)
            | (if ((.env | length) == 0) then del(.env) else . end) else . end
    ' "$settings") || { echo "[WARN] failed to strip permission profile."; return 1; }
    printf '%s\n' "$stripped" > "$settings"

    _record_permission_tier "$target" "default"
    echo "[done] Stripped managed permission profile; tier set to default."
    return 0
}

# _record_permission_tier <target> <tier> — record the tier in template.json.
_record_permission_tier() {
    local target="$1" tier="$2"
    local tj="$target/.claude/template.json"
    [[ -f "$tj" ]] || return 0
    command_exists jq || return 0
    local updated
    updated=$(jq --arg t "$tier" '.permissions = $t' "$tj") || return 0
    printf '%s\n' "$updated" > "$tj"
}

init_project() {
    local type="$1"
    local target="${2:-.}"

    # Validate template exists
    if [[ ! -d "$TEMPLATES_DIR/$type" ]]; then
        echo "Error: Unknown project type '$type'"
        echo ""
        list_templates
        exit 1
    fi

    # An add-on is installed beside the templates for the copy its own
    # instructions describe, but it is not a project type: refuse it before
    # anything is created (#498).
    if [[ -f "$TEMPLATES_DIR/$type/$ADDON_MARKER" ]]; then
        print_addon_refusal "$type"
        exit 1
    fi

    # Create target directory if needed
    mkdir -p "$target"
    target=$(cd "$target" && pwd)

    # Check if CLAUDE.md already exists
    if [[ -f "$target/CLAUDE.md" ]]; then
        echo "Warning: $target/CLAUDE.md already exists."
        read -p "Overwrite? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    fi

    # Copy template files
    cp "$TEMPLATES_DIR/$type/CLAUDE.md" "$target/CLAUDE.md"

    # Copy .claude directory contents if they exist
    if [[ -d "$TEMPLATES_DIR/$type/.claude" ]]; then
        mkdir -p "$target/.claude"
        cp -r "$TEMPLATES_DIR/$type/.claude/"* "$target/.claude/" 2>/dev/null || true
    fi

    # Copy commands if they exist
    if [[ -d "$TEMPLATES_DIR/$type/commands" ]]; then
        mkdir -p "$target/.claude/commands"
        cp -r "$TEMPLATES_DIR/$type/commands/"* "$target/.claude/commands/" 2>/dev/null || true
    fi

    # Copy .github directory (CI workflows) if it exists
    if [[ -d "$TEMPLATES_DIR/$type/.github" ]]; then
        cp -r "$TEMPLATES_DIR/$type/.github" "$target/" 2>/dev/null || true
    fi

    # Copy any other top-level template subdirs (e.g. domain-pack ships
    # content/, jvm-wrapper/, python-wrapper/, scripts/; gradle-plugin
    # ships plugin/, sample-consumer/, gradle/). Skip ones already handled
    # above and never overwrite the project's existing dirs.
    #
    # NOTE: trailing slash on the source path unwraps the directory contents
    # into $target. Strip it with `${extra%/}` so `cp -r` copies the
    # directory itself into $target, preserving the layout.
    for extra in "$TEMPLATES_DIR/$type"/*/; do
        [[ -d "$extra" ]] || continue
        local extra_name
        extra_name=$(basename "$extra")
        case "$extra_name" in
            commands|.claude|.github) continue ;;
        esac
        if [[ ! -e "$target/$extra_name" ]]; then
            cp -r "${extra%/}" "$target/" 2>/dev/null || true
        fi
    done

    # Copy any top-level regular files other than CLAUDE.md (e.g.
    # gradle-plugin ships settings.gradle.kts, build.gradle.kts, .gitignore at
    # the template root). Never overwrite an existing project file.
    while IFS= read -r -d '' extra_file; do
        local extra_name
        extra_name=$(basename "$extra_file")
        case "$extra_name" in
            CLAUDE.md|PROJECT.md) continue ;;
        esac
        if [[ ! -e "$target/$extra_name" ]]; then
            cp "$extra_file" "$target/$extra_name" 2>/dev/null || true
        fi
    done < <(find "$TEMPLATES_DIR/$type" -maxdepth 1 -type f -print0 2>/dev/null)

    # Write template metadata for sync support
    local hash
    hash=$(compute_template_hash "$TEMPLATES_DIR/$type/CLAUDE.md")
    mkdir -p "$target/.claude"
    cat > "$target/.claude/template.json" << TMPLEOF
{
  "name": "$type",
  "initialized": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "templateHash": "$hash"
}
TMPLEOF

    # Pre-approve git approval commands in settings.local.json.
    # The protect-git.sh hook blocks every git commit/push and instructs Claude to
    # create a one-time approval file via a combined "mkdir && touch" command.
    # That combined form must be pre-approved here so it runs without a permission
    # prompt — otherwise Claude Code prompts the user on every commit attempt.
    local repo_hash _uid
    _uid=$(id -u)
    repo_hash=$(compute_repo_hash "$target")
    local _adir="/tmp/.claude-git-approvals"
    local _cf="${_adir}/commit-${_uid}-${repo_hash}"
    local _pf="${_adir}/push-${_uid}-${repo_hash}"
    # Three approval variants matching protect-git.sh's three block-message branches:
    #   commit-only, push-only, and compound commit+push (one touch with two file args)
    local _cp="Bash(mkdir -p ${_adir} && touch ${_cf})"
    local _pp="Bash(mkdir -p ${_adir} && touch ${_pf})"
    local _both="Bash(mkdir -p ${_adir} && touch ${_cf} ${_pf})"
    local _sl="$target/.claude/settings.local.json"
    if [[ -f "$_sl" ]] && command_exists jq; then
        local _updated
        _updated=$(jq --arg cp "$_cp" --arg pp "$_pp" --arg both "$_both" '
            .permissions.allow //= [] |
            if (.permissions.allow | index($cp))   == null then .permissions.allow += [$cp]   else . end |
            if (.permissions.allow | index($pp))   == null then .permissions.allow += [$pp]   else . end |
            if (.permissions.allow | index($both)) == null then .permissions.allow += [$both] else . end
        ' "$_sl")
        echo "$_updated" > "$_sl"
        echo "[done] Added git approval permissions to .claude/settings.local.json"
    elif [[ ! -f "$_sl" ]]; then
        mkdir -p "$target/.claude"
        printf '{\n  "permissions": {\n    "allow": [\n      "%s",\n      "%s",\n      "%s"\n    ]\n  }\n}\n' \
            "$_cp" "$_pp" "$_both" > "$_sl"
        echo "[done] Created .claude/settings.local.json with git approval permissions"
    else
        echo "[WARN] jq not installed — could not write git approval permissions to settings.local.json"
        echo "       Add manually:"
        echo "         $_cp"
        echo "         $_pp"
        echo "         $_both"
    fi

    local _memkernel_status
    _memkernel_status=$(ensure_memkernel_settings_local "$target")
    case "$_memkernel_status" in
        updated)
            echo "[done] Added MemKernel MCP config to .claude/settings.local.json"
            ;;
        created)
            echo "[done] Created .claude/settings.local.json with MemKernel MCP config"
            ;;
        warn-no-jq)
            echo "[WARN] jq not installed — could not add MemKernel MCP config to settings.local.json"
            ;;
        warn-merge)
            echo "[WARN] Could not safely merge MemKernel MCP config into settings.local.json"
            ;;
    esac

    # Append Copyright & Licensing section to CLAUDE.md if --license was given
    if [[ -n "$LICENSE_TYPE" ]]; then
        local _year _company=""
        _year=$(date +%Y)
        local _providers
        _providers="$(cct_home_path providers.toml)"
        if [[ -f "$_providers" ]]; then
            _company=$(grep '^company[[:space:]]*=[[:space:]]*' "$_providers" \
                | head -1 \
                | sed 's/^company[[:space:]]*=[[:space:]]*"//; s/"[[:space:]]*$//' 2>/dev/null || echo "")
        fi
        {
            printf '\n## Copyright & Licensing\n\n'
            printf -- '- **Company**: %s\n' "${_company:-Unknown}"
            printf -- '- **License**: %s\n' "$LICENSE_TYPE"
        } >> "$target/CLAUDE.md"
        echo "[done] Added copyright section (company: '${_company:-Unknown}', license: $LICENSE_TYPE) to CLAUDE.md"
    fi

    # Install Playwright CLI skills for web templates if --playwright flag is set
    if [[ "$PLAYWRIGHT" == "1" ]]; then
        if command -v playwright-cli &>/dev/null; then
            (cd "$target" && playwright-cli install --skills 2>/dev/null) \
                && echo "[done] Playwright CLI skills installed" \
                || echo "[WARN] Playwright skills install failed (run 'playwright-cli install --skills' in project)"
        else
            echo "[WARN] playwright-cli not found. Install first:"
            echo "       npm install -g @playwright/cli@latest"
            echo "       Then run: cd $target && playwright-cli install --skills"
        fi
    fi

    # Permission profile. An explicitly chosen non-default tier was validated
    # and (for relaxed) confirmed by preflight_permission_tier BEFORE any files
    # were written, so a failure here is fatal — init must not claim success
    # with the wrong or missing safety boundary. Implicit/default never blocks.
    if [[ "${PERM_TIER:-default}" == "default" ]]; then
        apply_permission_profile "$target" "default" "$type" "0" || true
    else
        apply_permission_profile "$target" "$PERM_TIER" "$type" "${YES_DANGEROUS:-1}" || {
            echo "Error: failed to apply '$PERM_TIER' permission profile — init aborted."
            return 1
        }
    fi

    echo "Initialized '$type' project at $target"
    echo ""
    echo "Created files:"
    find "$target" -name "CLAUDE.md" -o -name "*.md" -path "*/.claude/*" | sort | while read f; do
        echo "  ${f#$target/}"
    done
    echo ""
    echo "Next steps:"
    echo "  1. Edit $target/CLAUDE.md to customize for your project"
    echo "  2. Run: cct start $target"
    echo ""
}

sync_project() {
    local target="${1:-.}"
    local dry_run="${2:-0}"

    # Resolve to absolute path
    if [[ ! -d "$target" ]]; then
        echo "Error: Directory '$target' does not exist."
        exit 1
    fi
    target=$(cd "$target" && pwd)

    # 1. Determine template name
    local template_name=""
    if [[ -f "$target/.claude/template.json" ]]; then
        if command_exists jq; then
            template_name=$(jq -r '.name // empty' "$target/.claude/template.json" 2>/dev/null)
        else
            template_name=$(grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' "$target/.claude/template.json" 2>/dev/null | head -1 | sed 's/.*"name"[[:space:]]*:[[:space:]]*"//; s/"//')
        fi
    fi

    # If no template.json, infer from CLAUDE.md heading (one-time backfill)
    local inferred=0
    if [[ -z "$template_name" ]]; then
        template_name=$(infer_template "$target" 2>/dev/null) || true
        if [[ -n "$template_name" ]]; then
            inferred=1
            echo "[info] No .claude/template.json found — inferred '$template_name' from CLAUDE.md heading."
            if [[ "$dry_run" == "1" ]]; then
                echo "       Run without --dry-run to record this in .claude/template.json."
            else
                echo "       This will be recorded so future syncs don't need inference."
            fi
            echo ""
        fi
    fi

    if [[ -z "$template_name" ]]; then
        echo "Error: Cannot determine template for this project."
        echo ""
        echo "No .claude/template.json found and could not match CLAUDE.md heading"
        echo "against any installed template."
        echo ""
        echo "Available templates:"
        list_templates
        echo "To set the template manually:"
        echo "  mkdir -p .claude"
        echo '  echo '"'"'{"name":"<template-name>"}'"'"' > .claude/template.json'
        exit 1
    fi

    # 2. Validate template exists
    if [[ ! -d "$TEMPLATES_DIR/$template_name" ]]; then
        echo "Error: Template '$template_name' not found in $TEMPLATES_DIR"
        echo "Run './scripts/setup.sh --sync --claude-code' from your checkout to update templates first."
        exit 1
    fi

    local tmpl_dir="$TEMPLATES_DIR/$template_name"
    local changes=0

    if [[ "$dry_run" == "1" ]]; then
        echo "Dry run: syncing $(basename "$target") against template '$template_name'"
    else
        echo "Syncing $(basename "$target") against template '$template_name'"
    fi
    echo ""

    # 2b. Permission-profile drift — REPORT ONLY (never auto-apply; a safety
    # boundary is switched explicitly via `claude-code permissions <tier>`).
    if command_exists jq && [[ -f "$target/.claude/template.json" ]]; then
        local rec_tier
        rec_tier=$(jq -r '.permissions // "default"' "$target/.claude/template.json" 2>/dev/null)
        if [[ -n "$rec_tier" && "$rec_tier" != "default" && "$rec_tier" != "null" ]]; then
            local prof="$PERMISSIONS_DIR/$rec_tier.json"
            local settings="$target/.claude/settings.json"
            if [[ ! -f "$settings" ]]; then
                echo "  [drift] recorded permission tier '$rec_tier' but no .claude/settings.json — run 'cct permissions $rec_tier'"
                echo ""
            elif [[ -f "$prof" ]] && ! jq -e -n --slurpfile p "$prof" --slurpfile s "$settings" '
                    ($p[0].permissions.defaultMode == $s[0].permissions.defaultMode)
                    and ((($p[0].permissions.allow // []) - ($s[0].permissions.allow // [])) | length == 0)
                    and ((($p[0].permissions.deny  // []) - ($s[0].permissions.deny  // [])) | length == 0)
                ' >/dev/null 2>&1; then
                echo "  [drift] permission profile '$rec_tier' differs from .claude/settings.json — run 'cct permissions $rec_tier' to re-apply (sync never auto-applies)"
                echo ""
            fi
        fi
    fi

    # 3. Sync commands
    if [[ -d "$tmpl_dir/commands" ]]; then
        for cmd_file in "$tmpl_dir/commands/"*.md; do
            [[ -f "$cmd_file" ]] || continue
            local cmd_name
            cmd_name=$(basename "$cmd_file")
            local dest="$target/.claude/commands/$cmd_name"

            if [[ ! -f "$dest" ]]; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [add] .claude/commands/$cmd_name (new)"
                else
                    mkdir -p "$target/.claude/commands"
                    cp "$cmd_file" "$dest"
                    echo "  [add] .claude/commands/$cmd_name"
                fi
                changes=$((changes + 1))
            elif ! diff -q "$cmd_file" "$dest" >/dev/null 2>&1; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [upd] .claude/commands/$cmd_name (changed)"
                    diff --unified=3 "$dest" "$cmd_file" 2>/dev/null | head -20 || true
                    echo ""
                else
                    cp "$cmd_file" "$dest"
                    echo "  [upd] .claude/commands/$cmd_name"
                fi
                changes=$((changes + 1))
            fi
        done
    fi

    # 4. Sync .claude directory contents (remediation.json, settings, etc.)
    if [[ -d "$tmpl_dir/.claude" ]]; then
        while IFS= read -r -d '' tmpl_file; do
            local rel_path="${tmpl_file#$tmpl_dir/}"
            local dest="$target/$rel_path"

            # Skip commands/ — handled above
            [[ "$rel_path" == .claude/commands/* ]] && continue

            if [[ ! -f "$dest" ]]; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [add] $rel_path (new)"
                else
                    mkdir -p "$(dirname "$dest")"
                    cp "$tmpl_file" "$dest"
                    echo "  [add] $rel_path"
                fi
                changes=$((changes + 1))
            elif ! diff -q "$tmpl_file" "$dest" >/dev/null 2>&1; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [upd] $rel_path (changed)"
                    diff --unified=3 "$dest" "$tmpl_file" 2>/dev/null | head -20 || true
                    echo ""
                else
                    cp "$tmpl_file" "$dest"
                    echo "  [upd] $rel_path"
                fi
                changes=$((changes + 1))
            fi
        done < <(find "$tmpl_dir/.claude" -type f -print0 2>/dev/null)
    fi

    # 4b. Sync .github directory contents (CI workflows)
    if [[ -d "$tmpl_dir/.github" ]]; then
        while IFS= read -r -d '' tmpl_file; do
            local rel_path="${tmpl_file#$tmpl_dir/}"
            local dest="$target/$rel_path"

            if [[ ! -f "$dest" ]]; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [add] $rel_path (new)"
                else
                    mkdir -p "$(dirname "$dest")"
                    cp "$tmpl_file" "$dest"
                    echo "  [add] $rel_path"
                fi
                changes=$((changes + 1))
            elif ! diff -q "$tmpl_file" "$dest" >/dev/null 2>&1; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [upd] $rel_path (changed)"
                    diff --unified=3 "$dest" "$tmpl_file" 2>/dev/null | head -20 || true
                    echo ""
                else
                    cp "$tmpl_file" "$dest"
                    echo "  [upd] $rel_path"
                fi
                changes=$((changes + 1))
            fi
        done < <(find "$tmpl_dir/.github" -type f -print0 2>/dev/null)
    fi

    # 4c. Sync any other top-level template subdirs (e.g. domain-pack ships
    # content/, jvm-wrapper/, python-wrapper/, scripts/; gradle-plugin ships
    # plugin/, sample-consumer/, gradle/). Treat these like
    # CLAUDE.md: add new files, but NEVER auto-overwrite existing ones —
    # consumers customize these (their actual content, their loader code,
    # their publish credentials). Changed files are reported as a hint, not
    # silently clobbered.
    for extra in "$tmpl_dir"/*/; do
        [[ -d "$extra" ]] || continue
        local extra_name
        extra_name=$(basename "$extra")
        case "$extra_name" in
            commands|.claude|.github) continue ;;
        esac
        while IFS= read -r -d '' tmpl_file; do
            local rel_path="${tmpl_file#$tmpl_dir/}"
            local dest="$target/$rel_path"

            if [[ ! -f "$dest" ]]; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [add] $rel_path (new)"
                else
                    mkdir -p "$(dirname "$dest")"
                    cp "$tmpl_file" "$dest"
                    echo "  [add] $rel_path"
                fi
                changes=$((changes + 1))
            elif ! diff -q "$tmpl_file" "$dest" >/dev/null 2>&1; then
                if [[ "$dry_run" == "1" ]]; then
                    echo "  [diff] $rel_path (consumer-owned — not overwritten)"
                    diff --unified=3 "$dest" "$tmpl_file" 2>/dev/null | head -20 || true
                    echo ""
                else
                    echo "  [diff] $rel_path differs from template — not overwritten (consumer-owned). Compare against $tmpl_dir/$rel_path to review."
                fi
                changes=$((changes + 1))
            fi
        done < <(find "$extra" -type f -print0 2>/dev/null)
    done

    # 4d. Sync top-level regular files (e.g. gradle-plugin ships
    # settings.gradle.kts, build.gradle.kts, .gitignore at the template
    # root). Same consumer-owned semantics: add new, never clobber.
    while IFS= read -r -d '' tmpl_file; do
        local extra_name
        extra_name=$(basename "$tmpl_file")
        case "$extra_name" in
            CLAUDE.md|PROJECT.md) continue ;;
        esac
        local dest="$target/$extra_name"
        if [[ ! -f "$dest" ]]; then
            if [[ "$dry_run" == "1" ]]; then
                echo "  [add] $extra_name (new)"
            else
                cp "$tmpl_file" "$dest"
                echo "  [add] $extra_name"
            fi
            changes=$((changes + 1))
        elif ! diff -q "$tmpl_file" "$dest" >/dev/null 2>&1; then
            if [[ "$dry_run" == "1" ]]; then
                echo "  [diff] $extra_name (consumer-owned — not overwritten)"
                diff --unified=3 "$dest" "$tmpl_file" 2>/dev/null | head -20 || true
                echo ""
            else
                echo "  [diff] $extra_name differs from template — not overwritten (consumer-owned). Compare against $tmpl_dir/$extra_name to review."
            fi
            changes=$((changes + 1))
        fi
    done < <(find "$tmpl_dir" -maxdepth 1 -type f -print0 2>/dev/null)

    # 5. Show CLAUDE.md diff (never auto-overwrite — user has customizations)
    if [[ -f "$tmpl_dir/CLAUDE.md" && -f "$target/CLAUDE.md" ]]; then
        local tmpl_hash proj_hash
        tmpl_hash=$(compute_template_hash "$tmpl_dir/CLAUDE.md")
        proj_hash=$(compute_template_hash "$target/CLAUDE.md")

        if [[ "$tmpl_hash" != "$proj_hash" ]]; then
            echo ""
            echo "  [info] CLAUDE.md differs from template (expected — you have customizations)"
            if [[ "$dry_run" == "1" ]]; then
                echo "  Template CLAUDE.md diff:"
                diff --unified=3 "$target/CLAUDE.md" "$tmpl_dir/CLAUDE.md" 2>/dev/null | head -40 || true
            else
                echo "  Review manually: diff '$target/CLAUDE.md' '$tmpl_dir/CLAUDE.md'"
            fi
        fi
    fi

    # 6. Update template.json (preserve initialized, add lastSynced)
    if [[ "$dry_run" != "1" ]]; then
        local hash initialized
        hash=$(compute_template_hash "$tmpl_dir/CLAUDE.md")
        initialized=""
        if [[ -f "$target/.claude/template.json" ]]; then
            if command_exists jq; then
                initialized=$(jq -r '.initialized // empty' "$target/.claude/template.json" 2>/dev/null)
            else
                initialized=$(grep -o '"initialized"[[:space:]]*:[[:space:]]*"[^"]*"' "$target/.claude/template.json" 2>/dev/null | head -1 | sed 's/.*"initialized"[[:space:]]*:[[:space:]]*"//; s/"//')
            fi
        fi
        if [[ -z "$initialized" ]]; then
            initialized=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        fi
        mkdir -p "$target/.claude"
        cat > "$target/.claude/template.json" << TMPLEOF
{
  "name": "$template_name",
  "initialized": "$initialized",
  "lastSynced": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "templateHash": "$hash"
}
TMPLEOF
    fi

    if [[ "$dry_run" != "1" ]]; then
        local memkernel_status
        memkernel_status=$(ensure_memkernel_settings_local "$target")
        case "$memkernel_status" in
            created)
                echo "  [add] .claude/settings.local.json (MemKernel MCP)"
                changes=$((changes + 1))
                ;;
            updated)
                echo "  [upd] .claude/settings.local.json (MemKernel MCP)"
                changes=$((changes + 1))
                ;;
            warn-no-jq)
                echo "  [warn] jq not installed — could not add MemKernel MCP config"
                ;;
            warn-merge)
                echo "  [warn] Could not safely merge MemKernel MCP config"
                ;;
        esac
    fi

    echo ""
    if [[ $changes -eq 0 ]]; then
        echo "Already up to date."
    elif [[ "$dry_run" == "1" ]]; then
        echo "$changes file(s) would be updated. Run without --dry-run to apply."
    else
        echo "$changes file(s) synced."
    fi
}

start_tmux_session() {
    local project_dir="${1:-.}"
    local session_start
    local run_cmd

    # Resolve to absolute path
    if [[ ! -d "$project_dir" ]]; then
        echo "Error: Directory '$project_dir' does not exist."
        echo "To create a new project, use: cct init <type> $project_dir"
        exit 1
    fi
    project_dir=$(cd "$project_dir" && pwd)

    # Generate session name from directory (sanitize for tmux)
    local dir_name=$(basename "$project_dir")
    local session_name="claude-${dir_name//[^a-zA-Z0-9_-]/_}"

    # Show project context summary
    echo "──────────────────────────────────────"
    echo "  Project: $dir_name"
    if git -C "$project_dir" rev-parse --is-inside-work-tree &>/dev/null; then
        local branch=$(git -C "$project_dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
        local last_commit=$(git -C "$project_dir" log -1 --oneline 2>/dev/null)
        local dirty=$(git -C "$project_dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        echo "  Branch:  $branch"
        echo "  Latest:  $last_commit"
        [[ "$dirty" -gt 0 ]] && echo "  Status:  $dirty uncommitted change(s)"
    fi
    [[ -f "$project_dir/CLAUDE.md" ]] && echo "  Config:  CLAUDE.md found" || echo "  Config:  No CLAUDE.md (run 'cct init <type>')"
    if [[ "$PEER_REVIEW_ENABLED" == "true" ]]; then
        echo "  Peer:    ${PEER_PROVIDER:-profile default} (scope: $PEER_SCOPE)"
    fi
    if [[ -n "$LLM_TARGET" ]]; then
        echo "  LLM:     $LLM_TARGET ($LLM_CC_LABEL)"
    fi

    # Session transcript logging
    mkdir -p "$LOGS_DIR"
    local timestamp=$(date +%Y-%m-%d-%H%M%S)
    local log_file="$LOGS_DIR/${dir_name}-${timestamp}.log"

    echo "  Shell:   tmux"
    echo "  Log:     $log_file"
    echo "──────────────────────────────────────"
    echo ""

    # If already inside tmux, run directly in the current pane
    if is_inside_tmux; then
        echo "Launching Claude in the current tmux pane..."
        exec_claude_in_current_shell "$project_dir" "$log_file"
    fi

    # Check if session already exists
    if tmux has-session -t "$session_name" 2>/dev/null; then
        # A selected launch never attaches to a session it did not start:
        # that session runs whatever it was started with, and attaching
        # would report a selection that was not applied.
        if [[ -n "$LLM_TARGET" ]]; then
            llm_refuse "tmux session '$session_name' already exists, and attaching to it would not apply the selection" \
                "Attach without --llm (claude-code $project_dir), or end that session first."
        fi
        # If peer-review flags changed, recreate the session so env vars are injected
        if [[ -n "$PEER_REVIEW_ENABLED" ]]; then
            echo "Recreating session '$session_name' with peer-review config..."
            tmux kill-session -t "$session_name" 2>/dev/null
        else
            echo "Session '$session_name' exists. Attaching..."
            # Start logging on the existing session (append to new log file)
            tmux pipe-pane -t "$session_name" -o "sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' >> '$log_file'"
            tmux attach-session -t "$session_name"
            return
        fi
    fi

    if [[ -n "$LLM_TARGET" ]]; then llm_refuse_untypable; fi

    echo "Creating session '$session_name'..."
    echo "  Log: $log_file"
    session_start=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    run_cmd=$(build_run_cmd_string "$session_start")
    # Create detached, set up logging, then attach
    tmux new-session -d -s "$session_name" -c "$project_dir" "$run_cmd"
    tmux pipe-pane -t "$session_name" -o "sed 's/\x1b\[[0-9;]*[a-zA-Z]//g' >> '$log_file'"
    # Show peer review banner inside tmux (after attach redraws the terminal)
    if [[ "$PEER_REVIEW_ENABLED" == "true" ]]; then
        tmux display-message -t "$session_name" \
            "Peer review: ${PEER_PROVIDER:-profile default} (scope: $PEER_SCOPE)"
    fi
    tmux attach-session -t "$session_name"
}

start_cmux_session() {
    local project_dir="${1:-.}"
    local dir_name session_start launch_cmd log_file

    if [[ ! -d "$project_dir" ]]; then
        echo "Error: Directory '$project_dir' does not exist."
        echo "To create a new project, use: cct init <type> $project_dir"
        exit 1
    fi
    project_dir=$(cd "$project_dir" && pwd)
    dir_name=$(basename "$project_dir")
    log_file=$(create_log_file "$dir_name")

    echo "──────────────────────────────────────"
    echo "  Project: $dir_name"
    if git -C "$project_dir" rev-parse --is-inside-work-tree &>/dev/null; then
        local branch last_commit dirty
        branch=$(git -C "$project_dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
        last_commit=$(git -C "$project_dir" log -1 --oneline 2>/dev/null)
        dirty=$(git -C "$project_dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
        echo "  Branch:  $branch"
        echo "  Latest:  $last_commit"
        [[ "$dirty" -gt 0 ]] && echo "  Status:  $dirty uncommitted change(s)"
    fi
    [[ -f "$project_dir/CLAUDE.md" ]] && echo "  Config:  CLAUDE.md found" || echo "  Config:  No CLAUDE.md (run 'cct init <type>')"
    if [[ "$PEER_REVIEW_ENABLED" == "true" ]]; then
        echo "  Peer:    ${PEER_PROVIDER:-profile default} (scope: $PEER_SCOPE)"
    fi
    if [[ -n "$LLM_TARGET" ]]; then
        echo "  LLM:     $LLM_TARGET ($LLM_CC_LABEL)"
    fi
    echo "  Shell:   cmux"
    echo "  Log:     $log_file"
    echo "──────────────────────────────────────"
    echo ""

    if is_inside_cmux; then
        echo "Launching Claude in the current cmux terminal..."
        exec_claude_in_current_shell "$project_dir" "$log_file"
    fi

    # The command below is TYPED into a new pane. Anything in it that
    # holds a control character is refused first.
    if [[ -n "$LLM_TARGET" ]]; then llm_refuse_untypable "$project_dir"; fi

    session_start=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    launch_cmd=$(build_launch_command "$project_dir" "$session_start" "$log_file")

    if command_exists cmux && launch_cmux_with_cli "$launch_cmd"; then
        echo "Opened a new cmux workspace and launched Claude."
        return
    fi

    if launch_cmux_with_osascript "$launch_cmd"; then
        echo "Opened a new cmux workspace and launched Claude."
        return
    fi

    copy_to_clipboard "$launch_cmd"
    echo "Unable to automate cmux launch."
    echo "The Claude launch command has been copied to your clipboard."
    echo "Paste it into a new cmux workspace:"
    echo "  $launch_cmd"
    exit 1
}

start_session() {
    local project_dir="${1:-.}"
    local selected_backend

    selected_backend=$(resolve_session_backend)

    # Inside an unsupported multiplexer (e.g. Zellij) — run directly
    if [[ "$selected_backend" == "direct" ]]; then
        if [[ ! -d "$project_dir" ]]; then
            echo "Error: Directory '$project_dir' does not exist."
            exit 1
        fi
        project_dir=$(cd "$project_dir" && pwd)
        local dir_name log_file
        dir_name=$(basename "$project_dir")
        log_file=$(create_log_file "$dir_name")
        echo "[info] Detected active Zellij session — launching Claude directly (Zellij is no longer a managed backend)."
        exec_claude_in_current_shell "$project_dir" "$log_file"
    fi

    # If explicitly requested, fail hard if unavailable
    if [[ "$SESSION_BACKEND" != "$BACKEND_AUTO" ]]; then
        case "$selected_backend" in
            "$BACKEND_CMUX")
                ensure_cmux_available || { echo "Error: cmux backend was requested explicitly but is unavailable."; exit 1; }
                start_cmux_session "$project_dir"
                return
                ;;
            "$BACKEND_TMUX")
                ensure_tmux_available || exit 1
                start_tmux_session "$project_dir"
                return
                ;;
            *)
                echo "Error: Unsupported shell backend '$selected_backend'. Use auto, cmux, or tmux."
                exit 1
                ;;
        esac
    fi

    # Auto mode: try resolved backend, then fall through alternatives
    if [[ "$selected_backend" == "$BACKEND_CMUX" ]] && ensure_cmux_available 2>/dev/null; then
        start_cmux_session "$project_dir"
        return
    fi

    if [[ "$selected_backend" == "$BACKEND_TMUX" ]] && command_exists tmux; then
        start_tmux_session "$project_dir"
        return
    fi

    # Resolved choice unavailable — try remaining backends in preference order
    if is_macos && ensure_cmux_available 2>/dev/null; then
        echo "[info] $selected_backend is unavailable; falling back to cmux."
        start_cmux_session "$project_dir"
        return
    fi

    if ensure_tmux_available; then
        echo "[info] $selected_backend is unavailable; falling back to tmux."
        start_tmux_session "$project_dir"
        return
    fi

    echo "Error: No session backend available. Install cmux or tmux."
    exit 1
}

# ── Main ─────────────────────────────────────────────────────

# ── Headless passthrough (#195) ──────────────────────────────
# A -p/--print invocation is a headless claude session (the auto-build
# driver's form), and --version is a probe. The wrapper's job there is
# CONFIG PARITY, not session management: the env fixes applied above
# (BUN_OPTIONS ipv4-first) plus the project's own .claude/settings.json
# (permission tier + hooks), which headless claude reads from cwd
# exactly like an interactive session. ALL args forward verbatim via
# exec — never attach cmux/tmux, never parse wrapper flags, never treat
# the -p value as a project path. stdout stays pure claude output (the
# driver parses result JSON from it): the invocation is logged, never
# tee'd.
# ── Gateway compatibility notice (#399) ──────────────────────
# When a deferred tool is loaded, Claude Code adds the tool's full
# definition to the conversation (a `tool_addition` block carrying a
# `tool_definition`). DeepSeek's Anthropic-compatible endpoint rejects
# that block — 422 "unknown variant `tool_definition`, expected
# `tool_reference`" — and the request fails before the model sees it;
# the retry-without-tool-search that Claude Code 2.1.305+ does after a
# 400/422 does not cover this block, and a session already carrying it
# keeps failing on resume. The wrapper cannot make a gateway accept it.
# What it can do is say so when a gateway is configured and no
# compatibility setting is. "Configured" means ANTHROPIC_BASE_URL is set;
# the wrapper never guesses a provider from the URL. Applying the
# variables belongs to an explicit per-launch selector (#400).
gateway_compat_notice() {
    [[ -n "${ANTHROPIC_BASE_URL:-}" ]] || return 0
    # Value-aware (review of PR #425): only the two settings that remove
    # the dynamic block count. ENABLE_TOOL_SEARCH=true or auto keeps tool
    # search on, and tool search is what adds the block.
    [[ "${CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS:-}" == "1" ]] && return 0
    [[ "$(printf '%s' "${ENABLE_TOOL_SEARCH:-}" | tr '[:upper:]' '[:lower:]')" == "false" ]] && return 0
    cat >&2 <<'NOTICE'
[claude-code] ANTHROPIC_BASE_URL is set and no tool-compatibility setting is.
  A gateway that rejects dynamic tool blocks (DeepSeek: 422 "unknown variant
  tool_definition, expected tool_reference") fails the request before the model
  sees it. If that happens, start a FRESH session with
    CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 ENABLE_TOOL_SEARCH=false DISABLE_FEEDBACK_COMMAND=1
  (a session that already carries the block keeps failing on resume).
  CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 or ENABLE_TOOL_SEARCH=false silences
  this notice; ENABLE_TOOL_SEARCH=true does not avoid the failure. Details:
  docs/dgx-spark/setup-cookbook.md, "Gateways that reject dynamic tool blocks".
NOTICE
}

run_headless() {
    local log_file
    mkdir -p "$LOGS_DIR" 2>/dev/null || true
    log_file="$LOGS_DIR/headless-$(basename "$PWD")-$(date +%Y-%m-%d-%H%M%S).log"
    { printf '%s headless: %s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        "${CLAUDE_CMD[*]}" "$*" >> "$log_file"; } 2>/dev/null || true
    exec "${CLAUDE_CMD[@]}" "$@"
}

# ── Per-launch LLM selection (#479, part of #400) ────────────
# --llm <target> runs THIS session on a target from the LLM catalog
# (${CCT_HOME:-~/.cct}/llms.toml; `cct llm list` shows it). The
# provider, credential and model variables are set in the process that
# becomes claude and nowhere else, and competing ones are removed from
# it, so nothing is exported in a shell and nothing a shell exports can
# redirect the session. Without --llm none of this runs and the launch
# is unchanged.
#
# Two steps:
#   prepare  in the launcher the user ran: resolve the target and refuse
#            (exit 3, with the reason) before any session vehicle is
#            touched. Reads no credential value.
#   apply    in the process about to exec claude: this one, or the
#            launcher re-run inside the pane it created (CCT_LLM_CHILD=1,
#            which prepares again there). Sets and removes the variables,
#            and stamps the session (#400 S4), in the environment the
#            session runs in.
# The catalog code lives in the checkout, like `build`'s driver.
LLM_TARGET=""
LLM_REST_ARGS=()
LLM_EXIT_REFUSED=3
LAUNCHER_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

llm_set_target() {  # <value given to --llm>
    if [[ -z "$1" || "${1:0:1}" == "-" ]]; then
        echo "Error: --llm requires a target (cct llm list shows them)" >&2
        exit 1
    fi
    LLM_TARGET="$1"
}

# Takes --llm out of an argument list that is otherwise forwarded to
# claude verbatim (the headless path): sets LLM_TARGET and LLM_REST_ARGS.
llm_split_args() {
    LLM_REST_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --llm)   llm_set_target "${2:-}"; shift 2 ;;
            --llm=*) llm_set_target "${1#*=}"; shift ;;
            *)       LLM_REST_ARGS+=("$1"); shift ;;
        esac
    done
}

llm_refuse() {  # <reason> [<remedy line>...]
    printf '[claude-code] --llm %s refused: %s\n' "$LLM_TARGET" "$1" >&2
    shift
    local line
    for line in "$@"; do printf '  %s\n' "$line" >&2; done
    exit "$LLM_EXIT_REFUSED"
}

# A control character must never be typed into a pane: a newline ends
# the command and an escape starts a terminal sequence. Matched byte by
# byte, whatever the locale: the C0 controls and DEL, and the C1
# controls in their UTF-8 form. Printable text is not refused, in
# whatever form %q writes it: bash 3.2 writes printable non-ASCII as
# $'…', which bash and zsh, the shells a pane runs, both read.
llm_has_control_char() {  # <value>
    ( LC_ALL=C
      case "$1" in
          *[[:cntrl:]]*) exit 0 ;;
          *$'\302'[$'\200'-$'\237']*) exit 0 ;;
      esac
      exit 1 )
}

llm_refuse_control_chars() {  # <value> <what it is> <remedy>
    if llm_has_control_char "$1"; then
        llm_refuse "the $2 holds a control character, which must never be typed into a new pane" "$3"
    fi
}

# Everything a selected launch TYPES into a new pane is checked: the
# project path (cmux types a `cd`; tmux is handed the directory as an
# argument and types none), this launcher's own path, and each flag
# forwarded to claude. The target is an id and cannot hold one. A launch
# from inside a pane types nothing and is not checked.
llm_refuse_untypable() {  # [<project-dir>]
    local arg in_pane="Run the launcher from inside a cmux or tmux pane, where nothing is typed"
    if [[ -n "${1:-}" ]]; then
        llm_refuse_control_chars "$1" "project path" "$in_pane, or rename the directory."
    fi
    llm_refuse_control_chars "$LAUNCHER_SELF" "launcher's own path" "$in_pane, or install the launcher under a plain path."
    for arg in ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}; do
        llm_refuse_control_chars "$arg" "argument forwarded to claude" "$in_pane."
    done
}

llm_load_libs() {
    local repo="${CCT_REPO_DIR:-$CCT_REPO_DIR_DEFAULT}"
    if [[ -z "$repo" || ! -f "$repo/scripts/lib/llm-catalog.sh" ]]; then
        # Fallback: this launcher is a checkout's own copy.
        repo="$(cd "$(dirname "$LAUNCHER_SELF")/../.." 2>/dev/null && pwd)" || repo=""
    fi
    if [[ -z "$repo" || ! -f "$repo/scripts/lib/llm-catalog.sh" ]]; then
        llm_refuse "cannot locate the code-copilot-team checkout (scripts/lib/llm-catalog.sh)" \
            "Set CCT_REPO_DIR to your checkout, or re-run adapters/claude-code/setup.sh from it."
    fi
    # shellcheck source=/dev/null
    source "$repo/scripts/lib/llm-catalog.sh"
    # shellcheck source=/dev/null
    source "$repo/scripts/lib/llm-adapters/claude-code.sh"
    # shellcheck source=/dev/null
    source "$repo/scripts/lib/llm-resolve.sh"
    # shellcheck source=/dev/null
    source "$repo/scripts/lib/cct-statefile.sh"
    # shellcheck source=/dev/null
    source "$repo/scripts/lib/llm-compat.sh"
    # shellcheck source=/dev/null
    source "$repo/scripts/lib/llm-sessions.sh"
}

# ── Sessions and resume (#400 FR-17, FR-18, FR-19, D9; slice S4) ──
# A --llm session is stamped before claude runs, under the id the launcher
# generates and passes with --session-id. Resumed by that id it keeps its
# target; a different target, a bare --continue or the picker is refused.
LLM_HEADLESS=0
LLM_UUID_RE='^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$'
llm_stamps_dir() { printf '%s/llm-sessions/claude-code\n' "$(cct_home)"; }

# These read the arguments as Claude Code's option parser (commander) does,
# without the checkout's libraries, so a native launch reads nothing new.
# Claude Code 2.1.332's options that take a value, from the capture
# (specs/llm-catalog/verification/claude-code-session-capture.md, section
# 12): every other option takes none, and one Claude Code does not know is
# its own error, so it starts no session.
LLM_CC_OPTS_REQUIRED=" --add-dir --advisor --agent --agent-color --agent-id --agent-name --agent-type --agents --allowed-tools --allowedTools --append-subagent-system-prompt --append-subagent-system-prompt-file --append-system-prompt --append-system-prompt-file --attach-serve --autocompact --betas --channels --client-data-url --correlation-id --dangerously-load-development-channels --debug-file --deep-link-cwd-b64 --deep-link-last-fetch --deep-link-repo --disallowed-tools --disallowedTools --effort --environment --fallback-model --fast-mode --file --forward-home-settings --inherit-permission-mode --initialize-fields --input-format --json-schema --lead-verify-key --managed-settings --max-budget-usd --max-thinking-tokens --max-turns --mcp-config --messaging-socket-path --metadata --model --name --on-branch --output-format --parent-session-id --permission-mode --permission-prompt-tool --permission-prompts --plan-mode-instructions --plugin-dir --plugin-dir-no-mcp --plugin-url --pool --prefill --prefill-b64 --proactivity --project-config-root --ref --remote-control-session-name-prefix --resume-drops-turn --resume-session-at --rewind-files --runner-declares --sdk-url --session-began-as-copy --session-id --setting-sources --settings --system-prompt --system-prompt-file --system-prompt-snapshot --task-budget --team-name --teammate-mode --thinking --thinking-display --tools --watch-artifact --watch-artifact-no-autoreact --workload -n "
LLM_CC_OPTS_OPTIONAL=" --cloud --debug --from-pr --prompt-suggestions --rc --remote --remote-control --resume --teleport --worktree -d -r -w "

_llm_arity() {  # <option>: LLM_ARITY = required | optional | none
    if [[ "$LLM_CC_OPTS_REQUIRED" == *" $1 "* ]]; then LLM_ARITY=required
    elif [[ "$LLM_CC_OPTS_OPTIONAL" == *" $1 "* ]]; then LLM_ARITY=optional
    else LLM_ARITY=none; fi
}

_llm_scan_option() {  # <option> <value> <has value: 0|1> <as written>
    case "$1" in
        --continue|-c)
            if [[ -z "$LLM_SCAN_CONT" ]]; then
                if [[ "$4" == "$1" ]]; then LLM_SCAN_CONT="$1"; else LLM_SCAN_CONT="$1 (in $4)"; fi
            fi ;;
        --resume|-r)
            LLM_SCAN_RESUME=1 LLM_SCAN_RESUME_ID=""
            if [[ "$3" == 1 && "$2" =~ $LLM_UUID_RE ]]; then LLM_SCAN_RESUME_ID="$2"; fi ;;
        --teleport|--from-pr) [[ -n "$LLM_SCAN_LINKED" ]] || LLM_SCAN_LINKED="$1" ;;
        --fork-session) LLM_SCAN_FORK=1 ;;
        --session-id) LLM_SCAN_ID_GIVEN=1 ;;
    esac
}

# llm_scan_claude_args <claude args...>: what Claude Code makes of them.
#   LLM_SCAN_CONT       --continue as written: --continue, -c, "-c (in -pc)"
#   LLM_SCAN_LINKED     --teleport or --from-pr
#   LLM_SCAN_RESUME     1 with a --resume; the last one wins
#   LLM_SCAN_RESUME_ID  the session id it names, or "" (the picker, a name
#                       or a search term)
#   LLM_SCAN_FORK       1 with --fork-session
#   LLM_SCAN_ID_GIVEN   1 with a --session-id
# Read as commander reads them: an option that requires a value takes the
# next argument, whatever it is (--append-system-prompt --resume makes
# "--resume" the prompt); an optional value is the next argument unless it
# looks like an option; --name=value gives one; everything after -- is
# text. A single-dash cluster is read letter by letter, and a letter that
# takes a value takes the rest of the cluster, or else the next argument
# (-pr <id> is -p -r <id>; -prX is -p -r X; -rp is -r p).
llm_scan_claude_args() {  # <claude args...>
    local arg rest letter value has
    LLM_SCAN_CONT="" LLM_SCAN_LINKED="" LLM_SCAN_RESUME=0 LLM_SCAN_RESUME_ID="" LLM_SCAN_FORK=0 LLM_SCAN_ID_GIVEN=0
    while [[ $# -gt 0 ]]; do
        arg="$1"; shift
        case "$arg" in
            --) break ;;
            --?*=*)
                _llm_arity "${arg%%=*}"
                [[ "$LLM_ARITY" == none ]] || _llm_scan_option "${arg%%=*}" "${arg#*=}" 1 "$arg" ;;
            --?*)
                _llm_arity "$arg"; value="" has=0
                if [[ $# -gt 0 ]]; then
                    if [[ "$LLM_ARITY" == required ]] \
                        || [[ "$LLM_ARITY" == optional && ! ( ${#1} -gt 1 && "${1:0:1}" == "-" ) ]]; then
                        value="$1" has=1; shift
                    fi
                fi
                _llm_scan_option "$arg" "$value" "$has" "$arg" ;;
            -?*)
                rest="${arg#-}"
                while [[ -n "$rest" ]]; do
                    letter="-${rest:0:1}" rest="${rest:1}"
                    _llm_arity "$letter"
                    if [[ "$LLM_ARITY" == none ]]; then _llm_scan_option "$letter" "" 0 "$arg"; continue; fi
                    value="" has=0
                    if [[ -n "$rest" ]]; then
                        value="$rest" has=1
                    elif [[ $# -gt 0 ]]; then
                        if [[ "$LLM_ARITY" == required ]] || [[ ! ( ${#1} -gt 1 && "${1:0:1}" == "-" ) ]]; then
                            value="$1" has=1; shift
                        fi
                    fi
                    _llm_scan_option "$letter" "$value" "$has" "$arg"
                    break
                done ;;
        esac
    done
    if [[ -n "$LLM_SCAN_RESUME_ID" ]]; then LLM_SCAN_RESUME_ID=$(printf '%s' "$LLM_SCAN_RESUME_ID" | tr 'A-F' 'a-f'); fi
    return 0
}

# The flag Claude Code acts on before --resume, as written: --continue, -c,
# "-c (in -pc)", --teleport or --from-pr.
llm_resume_override() {  # <claude args...>
    llm_scan_claude_args "$@"
    if [[ -n "$LLM_SCAN_CONT" ]]; then printf '%s\n' "$LLM_SCAN_CONT"; return 0; fi
    if [[ -n "$LLM_SCAN_LINKED" ]]; then printf '%s\n' "$LLM_SCAN_LINKED"; return 0; fi
    return 1
}

# The session id the last --resume names, whatever Claude Code would act on
# first.
llm_named_resume_id() {  # <claude args...>
    llm_scan_claude_args "$@"
    [[ -n "$LLM_SCAN_RESUME_ID" ]] || return 1
    printf '%s\n' "$LLM_SCAN_RESUME_ID"
}

# The session id Claude Code resumes: one named, with nothing it acts on
# before --resume.
llm_resume_id() {  # <claude args...>
    llm_scan_claude_args "$@"
    [[ -z "$LLM_SCAN_CONT" && -z "$LLM_SCAN_LINKED" && -n "$LLM_SCAN_RESUME_ID" ]] || return 1
    printf '%s\n' "$LLM_SCAN_RESUME_ID"
}

# 0 when Claude Code picks the session: --continue in any form, --resume
# without an id or with a name (the picker), or --from-pr (a session linked
# to a PR, or a picker of them).
llm_resume_unpinned() {  # <claude args...>
    llm_resume_id "$@" >/dev/null && return 1
    [[ -n "$LLM_SCAN_CONT" || "$LLM_SCAN_LINKED" == "--from-pr" || "$LLM_SCAN_RESUME" == 1 ]]
}

# The launch as lss_rules reads it (LSS_MODE and the rest; see
# llm-sessions.sh), in Claude Code's own order (2.1.332): --continue first,
# then --teleport and --from-pr, then --resume.
llm_classify_launch() {  # <claude args...>
    llm_scan_claude_args "$@"
    LSS_MODE="new" LSS_RESUME_ID="" LSS_CONT_FLAG="$LLM_SCAN_CONT"
    LSS_LINKED_FLAG="$LLM_SCAN_LINKED" LSS_ID_GIVEN="$LLM_SCAN_ID_GIVEN"
    if [[ -n "$LLM_SCAN_CONT" ]]; then LSS_MODE="continue"
    elif [[ -n "$LLM_SCAN_LINKED" ]]; then LSS_MODE="linked"
    elif [[ -n "$LLM_SCAN_RESUME_ID" ]]; then
        LSS_RESUME_ID="$LLM_SCAN_RESUME_ID"
        if [[ "$LLM_SCAN_FORK" == 1 ]]; then LSS_MODE="fork"; else LSS_MODE="exact"; fi
    elif [[ "$LLM_SCAN_RESUME" == 1 ]]; then LSS_MODE="picker"
    fi
    return 0
}

# FR-18: resumed by its id without --llm, a session started with --llm runs
# on the target its stamp names, re-resolved like a fresh --llm (FR-19). A
# session without a stamp resumes natively, as before, and so does a fork:
# it is a new session. A stamped session named beside a flag Claude Code
# acts on first is refused: Claude Code would resume another session, on
# the target restored for this one.
llm_restore_target() {  # <claude args...>
    local id rc=0 flag
    llm_scan_claude_args "$@"
    [[ "$LLM_SCAN_FORK" == 1 ]] && return 0
    id=$(llm_named_resume_id "$@") || return 0
    [[ -e "$(llm_stamps_dir)/$id.json" || -L "$(llm_stamps_dir)/$id.json" ]] || return 0
    LLM_TARGET="(the target of session $id)"   # names the launch in a refusal until it is read
    if flag=$(llm_resume_override "$@"); then
        llm_refuse "session $id has a stamp, but Claude Code acts on $flag first and resumes another session, which would run on this one's target" \
            "Resume it alone: --resume $id (its target is restored), or drop --resume $id."
    fi
    llm_load_libs
    lss_read "$LLM_CC_HARNESS" "$id" || rc=$?
    case "$rc" in
        0) LLM_TARGET="$LSS_STAMP_TARGET"
           printf '[claude-code] session %s was started with --llm %s: resuming it on that target.\n' "$id" "$LLM_TARGET" >&2 ;;
        1) LLM_TARGET="" ;;
        *) llm_refuse "$LSS_ERR" ;;
    esac
}

# FR-18 for a native launch: a bare --continue or the picker resumes
# whichever session Claude Code picks. Said once, and only where stamped
# sessions exist, so a launcher that never used --llm is unchanged.
llm_unpinned_notice() {  # <claude args...>
    llm_resume_unpinned "$@" || return 0
    [[ -d "$(llm_stamps_dir)" ]] || return 0
    printf '[claude-code] note: this resumes whichever session Claude Code picks, with no check of the LLM it was started with; resume by id (--resume <session-id>) for that check.\n' >&2
}

# FR-18 and FR-19 for a --llm launch, in the launcher the user ran and again
# in a pane's child: refused (exit 3) before anything starts.
llm_session_rules() {
    local line rc=0 remedies=()
    if [[ "$LLM_HEADLESS" == 1 ]]; then
        llm_classify_launch ${LLM_REST_ARGS[@]+"${LLM_REST_ARGS[@]}"}
    else
        llm_classify_launch ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
    fi
    # D9: the launcher chooses the id. One given could name a session that
    # exists, whose stamp would be replaced before claude refused the id.
    if [[ "$LSS_ID_GIVEN" == 1 ]]; then
        llm_refuse "--session-id is not accepted with --llm: the launcher generates the session id and stamps it before claude starts" \
            "Drop --session-id: the id is printed at start, and --resume <id> resumes the session on its target."
    fi
    lss_rules "$LLM_CC_HARNESS" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
        while IFS= read -r line; do [[ -n "$line" ]] && remedies+=("$line"); done <<< "$LSS_REMEDY"
        llm_refuse "$LSS_REFUSAL" ${remedies[@]+"${remedies[@]}"}
    fi
    if [[ -n "$LSS_NOTICE" ]]; then printf '[claude-code] note: %s\n' "$LSS_NOTICE" >&2; fi
}

# FR-17 and D9, in the process about to exec claude, where its environment
# is the session's: a new session or a fork gets the id the launcher
# generates and its stamp; a session resumed by its id is promoted when its
# transcript shows a reply, and its stamp refreshed. The id goes right after
# claude, ahead of the forwarded flags, so that none of them can take it as
# its value (an option that requires one takes the next argument).
llm_session_stamp() {
    local id
    case "$LSS_MODE" in
        new|fork)
            id=$(lss_new_id) || llm_refuse "cannot generate a session id (uuidgen, /proc/sys/kernel/random/uuid or python3 is needed)"
            CLAUDE_CMD=("${CLAUDE_CMD[0]}" --session-id "$id" "${CLAUDE_CMD[@]:1}")
            if [[ "$LSS_MODE" == fork ]]; then
                lss_stamp_new "$LLM_CC_HARNESS" "$id" "$LSS_RESUME_ID" || llm_refuse "cannot write the stamp of session $id: $LSS_ERR"
            else
                lss_stamp_new "$LLM_CC_HARNESS" "$id" || llm_refuse "cannot write the stamp of session $id: $LSS_ERR"
            fi
            ;;
        exact)
            id="$LSS_RESUME_ID"
            lss_promote "$LLM_CC_HARNESS" "$id" || true
            lss_stamp_refresh "$LLM_CC_HARNESS" "$id" || llm_refuse "cannot refresh the stamp of session $id: $LSS_ERR"
            ;;
    esac
    printf '[claude-code] session %s (resume it with --resume %s)\n' "$id" "$id" >&2
}

llm_prepare() {  # <project-dir>
    local project="$1" catalog rc=0 note
    llm_load_libs
    catalog="$(lc_catalog_path)"
    if [[ ! -e "$catalog" ]]; then
        llm_refuse "there is no LLM catalog at $catalog" \
            "Copy shared/templates/llm/llms.toml.example from your checkout there and edit it (docs/llm-catalog.md)."
    fi
    # Validated in THIS shell (the parsed catalog stays for the resolver);
    # a failure is printed by a second run.
    lc_validate "$catalog" >/dev/null || rc=$?
    if [[ $rc -ne 0 ]]; then
        printf '[claude-code] --llm %s refused: the LLM catalog is not valid (%s)\n' "$LLM_TARGET" "$catalog" >&2
        { lc_validate "$catalog" || true; } | sed 's/^/  /' >&2
        exit "$LLM_EXIT_REFUSED"
    fi
    # The resolver `cct harness explain` uses, so a launch and its
    # explanation cannot disagree (#400 FR-9).
    if ! lr_resolve "$LLM_CC_HARNESS" "$LLM_TARGET" "$project"; then
        llm_refuse "$LR_REFUSAL"
    fi
    if [[ "$LLM_CC_STATE" != "unverified" ]]; then
        llm_refuse "$LC_R_LLM@$LC_R_BINDING is $LLM_CC_STATE on $LLM_CC_HARNESS: $LLM_CC_REASON"
    fi
    # In THIS shell: the function reports through two globals.
    rc=0
    llm_cc_settings_conflicts "$project" || rc=$?
    if [[ $rc -eq 1 ]]; then
        printf '[claude-code] --llm %s refused: a Claude Code settings file sets a variable this launch must control.\n' "$LLM_TARGET" >&2
        printf '  Claude Code applies a settings env block over the environment it is started with, so the selection would be undone:\n' >&2
        printf '%s' "$LLM_CC_SETTINGS_REFUSED" | sed 's/^/    /' >&2
        printf '  Remove those keys from the env block, then retry.\n' >&2
        exit "$LLM_EXIT_REFUSED"
    elif [[ $rc -eq 2 ]]; then
        echo "[claude-code] note: jq is not installed, so settings.json env blocks were not checked for variables that would override --llm $LLM_TARGET" >&2
    fi
    # Tuning in a settings file does not change the target, so it is
    # said, not refused: that value is the one the session will use.
    while IFS= read -r note; do
        [[ -z "$note" ]] && continue
        printf '[claude-code] note: %s sets %s in its env block; Claude Code applies it over this launch, so that value is the one the session uses.\n' \
            "${note%: *}" "${note##*: }" >&2
    done <<< "$LLM_CC_SETTINGS_NOTED"
    llm_session_rules
    return 0
}

llm_apply() {
    # The pane marker must not reach claude: a launcher started from
    # inside the session would take itself for that pane's child.
    unset CCT_LLM_CHILD
    printf '[claude-code] --llm %s: %s (not probed: nothing has checked this model against Claude Code yet)\n' \
        "$LLM_TARGET" "$LLM_CC_LABEL" >&2
    llm_session_stamp
    llm_cc_apply
}

for _arg in "$@"; do
    case "$_arg" in
        -p|--print)
            llm_split_args "$@"
            if [[ -z "$LLM_TARGET" ]]; then llm_restore_target ${LLM_REST_ARGS[@]+"${LLM_REST_ARGS[@]}"}; fi
            if [[ -n "$LLM_TARGET" ]]; then
                LLM_HEADLESS=1
                llm_prepare "$PWD"
                llm_apply
                run_headless "${LLM_REST_ARGS[@]}"
            fi
            llm_unpinned_notice "$@"
            gateway_compat_notice
            run_headless "$@"
            ;;
        --version)
            run_headless "$@"
            ;;
        init|list|sync|playwright|permissions|build|help|-h|--help)
            # A wrapper subcommand owns everything after it — a -p beyond
            # this point is that subcommand's business, not headless intent.
            break
            ;;
    esac
done
unset _arg

# ── Flag parsing ─────────────────────────────────────────────
PLAYWRIGHT=0
LICENSE_TYPE=""
PERM_TIER=""
YES_DANGEROUS=0
PEER_REVIEW_ENABLED=""
PEER_PROVIDER=""
PEER_SCOPE="both"
REVIEW_COMMITS="squash"
REVIEW_MAX_ROUNDS=""
CLAUDE_ARGS=()
POSITIONAL=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --continue|-c)
            CLAUDE_ARGS+=("--continue")
            shift
            ;;
        --resume|-r)
            # A session id after it resumes that session (and keeps its
            # --llm target, #400 FR-18); anything else is the picker's
            # business, and a path is still the project directory.
            if [[ "${2:-}" =~ $LLM_UUID_RE ]]; then
                CLAUDE_ARGS+=("--resume" "$2")
                shift 2
            else
                CLAUDE_ARGS+=("--resume")
                shift
            fi
            ;;
        --peer-review)
            PEER_REVIEW_ENABLED="true"
            # Next arg is provider name only if it's not a flag, not a path, and not an existing directory
            if [[ -n "${2:-}" && "${2:0:2}" != "--" && "${2:0:1}" != "/" && "${2:0:2}" != "./" && "${2:0:1}" != "~" && "$2" != */* && ! -d "$2" ]]; then
                PEER_PROVIDER="$2"
                shift
            fi
            shift
            ;;
        --peer-review-off)
            PEER_REVIEW_ENABLED="false"
            shift
            ;;
        --peer-review-scope)
            PEER_SCOPE="${2:-both}"
            shift 2
            ;;
        --review-commits)
            REVIEW_COMMITS="${2:-squash}"
            case "$REVIEW_COMMITS" in
                single|per-round|squash) ;;
                *) echo "Error: --review-commits must be single, per-round, or squash"; exit 1 ;;
            esac
            shift 2
            ;;
        --review-max-rounds)
            REVIEW_MAX_ROUNDS="${2:?--review-max-rounds requires a number}"
            if ! [[ "$REVIEW_MAX_ROUNDS" =~ ^[0-9]+$ ]]; then
                echo "Error: --review-max-rounds must be a positive integer, got '$REVIEW_MAX_ROUNDS'"
                exit 1
            fi
            shift 2
            ;;
        --shell)
            if [[ -z "${2:-}" ]]; then
                echo "Error: --shell requires one of: auto, cmux, tmux"
                exit 1
            fi
            SESSION_BACKEND="${2:-$BACKEND_AUTO}"
            case "$SESSION_BACKEND" in
                "$BACKEND_AUTO"|"$BACKEND_CMUX"|"$BACKEND_TMUX")
                    ;;
                *)
                    echo "Error: Unsupported shell backend '$SESSION_BACKEND'. Use auto, cmux, or tmux."
                    exit 1
                    ;;
            esac
            shift 2
            ;;
        --playwright)
            PLAYWRIGHT=1
            shift
            ;;
        --llm)
            llm_set_target "${2:-}"
            shift 2
            ;;
        --llm=*)
            llm_set_target "${1#*=}"
            shift
            ;;
        *)
            # Subcommand boundary: once we hit a known wrapper subcommand,
            # stop global parsing so the subcommand owns its remaining
            # flags. Without this, `claude-code sync --dry-run` would
            # forward --dry-run to claude before the sync parser ran,
            # and `claude-code init <type> --license MIT` would lose
            # --license the same way.
            #
            # Otherwise: unknown --flag → forward verbatim to claude.
            # Boolean flags work as-is (e.g. --dangerously-skip-permissions).
            # For value-bearing flags use the --flag=value form to avoid
            # ambiguity with the project-dir positional on the
            # start-session path.
            case "$1" in
                init|list|sync|playwright|build|help|-h|--help)
                    POSITIONAL+=("$@")
                    break
                    ;;
                --*)
                    CLAUDE_ARGS+=("$1")
                    shift
                    ;;
                *)
                    POSITIONAL+=("$1")
                    shift
                    ;;
            esac
            ;;
    esac
done
set -- "${POSITIONAL[@]+"${POSITIONAL[@]}"}"

# Append claude-specific flags to the command. CLAUDE_CMD is an array
# so multi-token forms (e.g. "claude" "--dangerously-skip-permissions")
# can be exec'd correctly without bash collapsing them into a single
# token whose path doesn't resolve.
if [[ ${#CLAUDE_ARGS[@]} -gt 0 ]]; then
    CLAUDE_CMD+=("${CLAUDE_ARGS[@]}")
fi

# --llm selects the LLM of a SESSION; a wrapper subcommand starts none.
if [[ -n "$LLM_TARGET" ]]; then
    case "${1:-}" in
        init|build|permissions|list|sync|playwright|help|-h|--help)
            echo "Error: --llm selects the LLM for a session; it does not apply to '$1'." >&2
            exit 1
            ;;
    esac
fi

case "${1:-}" in
    init)
        shift
        # Parse --playwright, --license, --permissions, --yes-dangerous flags
        ARGS=()
        PERM_TIER=""
        YES_DANGEROUS=0
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --playwright)
                    PLAYWRIGHT=1
                    shift
                    ;;
                --license)
                    if [[ -z "${2:-}" || "${2:0:2}" == "--" ]]; then
                        echo "Error: --license requires a value (e.g. --license MIT)"
                        exit 1
                    fi
                    LICENSE_TYPE="$2"
                    shift 2
                    ;;
                --permissions)
                    if [[ -z "${2:-}" || "${2:0:2}" == "--" ]]; then
                        echo "Error: --permissions requires a value (default|balanced|relaxed)"
                        exit 1
                    fi
                    PERM_TIER="$2"
                    shift 2
                    ;;
                --permissions=*)
                    PERM_TIER="${1#*=}"
                    shift
                    ;;
                --yes-dangerous)
                    YES_DANGEROUS=1
                    shift
                    ;;
                *)
                    ARGS+=("$1")
                    shift
                    ;;
            esac
        done
        if [[ ${#ARGS[@]} -eq 0 ]]; then
            echo "Error: Missing project type."
            echo "Usage: cct init <type> [path] [--permissions <tier>] [--yes-dangerous] [--playwright] [--license <type>]"
            echo ""
            list_templates
            exit 1
        fi
        # Tier resolution: flag > interactive TTY prompt > default. Scripts/CI
        # (no TTY) silently get 'default' so init never blocks automation.
        if [[ -z "$PERM_TIER" ]]; then
            if [[ -t 0 ]]; then
                echo "Select a permission tier for this project:"
                echo "  1) default  — prompt for everything (safe; shared or unfamiliar repos)"
                echo "  2) balanced — zero prompts for repo work, guarded destructives (recommended for your own repos)"
                echo "  3) relaxed  — fully autonomous, protect hooks disarmed (DANGEROUS)"
                read -p "Tier [1-3, default 1]: " -r _perm_choice || true
                case "$_perm_choice" in
                    2) PERM_TIER="balanced" ;;
                    3) PERM_TIER="relaxed" ;;
                    *) PERM_TIER="default" ;;
                esac
            else
                PERM_TIER="default"
            fi
        fi
        # Validate + confirm the chosen tier BEFORE init writes any files, so a
        # bad/declined tier never leaves a project with the wrong boundary.
        preflight_permission_tier "$PERM_TIER" || exit 1
        init_project "${ARGS[0]}" "${ARGS[1]:-}"
        ;;
    build)
        # Autonomous no-human-in-loop build (#195): the branded entry to
        # scripts/auto-build-loop.sh — profiles, caps, and review gates
        # included; autonomous intent never needs
        # --dangerously-skip-permissions.
        shift
        CCT_REPO="${CCT_REPO_DIR:-$CCT_REPO_DIR_DEFAULT}"
        if [[ -z "$CCT_REPO" || ! -f "$CCT_REPO/scripts/auto-build-loop.sh" ]]; then
            # Fallback: cwd is (or is inside) the code-copilot-team repo.
            probe="$PWD"
            while [[ "$probe" != "/" ]]; do
                if [[ -f "$probe/scripts/auto-build-loop.sh" ]]; then
                    CCT_REPO="$probe"
                    break
                fi
                probe="$(dirname "$probe")"
            done
        fi
        if [[ -z "$CCT_REPO" || ! -f "$CCT_REPO/scripts/auto-build-loop.sh" ]]; then
            echo "Error: cannot locate the code-copilot-team repo (scripts/auto-build-loop.sh)."
            echo "Set CCT_REPO_DIR to your checkout, or re-run adapters/claude-code/setup.sh"
            echo "from the checkout so the path is baked into the installed launcher."
            exit 1
        fi
        exec env CCT_PROJECT_DIR="$PWD" bash "$CCT_REPO/scripts/auto-build-loop.sh" "$@"
        ;;
    permissions)
        shift
        PERM_TIER=""
        YES_DANGEROUS=0
        PERM_ARGS=()
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --yes-dangerous) YES_DANGEROUS=1; shift ;;
                -*) echo "Unknown option: $1"; exit 1 ;;
                *) PERM_ARGS+=("$1"); shift ;;
            esac
        done
        perm_tier="${PERM_ARGS[0]:-}"
        perm_target="${PERM_ARGS[1]:-.}"
        if [[ -z "$perm_tier" ]]; then
            echo "Usage: cct permissions <default|balanced|relaxed> [dir] [--yes-dangerous]"
            exit 1
        fi
        if [[ ! -d "$perm_target" ]]; then
            echo "Error: Directory '$perm_target' does not exist."
            exit 1
        fi
        perm_target=$(cd "$perm_target" && pwd)
        # Template type (for per-stack deny-extras) from the project's metadata.
        perm_type=""
        if [[ -f "$perm_target/.claude/template.json" ]] && command_exists jq; then
            perm_type=$(jq -r '.name // empty' "$perm_target/.claude/template.json" 2>/dev/null)
        fi
        if [[ "$perm_tier" == "default" ]]; then
            strip_permission_profile "$perm_target"
        else
            apply_permission_profile "$perm_target" "$perm_tier" "$perm_type" "$YES_DANGEROUS" || exit 1
        fi
        ;;
    list)
        list_templates
        ;;
    sync)
        shift
        SYNC_DRY_RUN=0
        SYNC_ARGS=()
        for arg in "$@"; do
            if [[ "$arg" == "--dry-run" ]]; then
                SYNC_DRY_RUN=1
            else
                SYNC_ARGS+=("$arg")
            fi
        done
        sync_project "${SYNC_ARGS[0]:-.}" "$SYNC_DRY_RUN"
        ;;
    playwright)
        target="${2:-.}"
        if [[ ! -d "$target" ]]; then
            echo "Error: Directory '$target' does not exist."
            exit 1
        fi
        target=$(cd "$target" && pwd)
        if command -v playwright-cli &>/dev/null; then
            (cd "$target" && playwright-cli install --skills) \
                && echo "[done] Playwright CLI skills installed in $target" \
                || echo "[FAIL] Playwright skills install failed"
        else
            echo "Error: playwright-cli not found."
            echo "Install first: npm install -g @playwright/cli@latest"
            exit 1
        fi
        ;;
    help|-h|--help)
        show_help
        ;;
    *)
        if [[ -z "$LLM_TARGET" ]]; then llm_restore_target ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}; fi
        if [[ -n "$LLM_TARGET" ]]; then
            if [[ "${CCT_LLM_CHILD:-}" == "1" ]]; then
                # Inside the pane this launcher created: no session
                # vehicle and no banner, only resolve, apply and exec. The
                # pane's environment can differ from the launcher's, so the
                # pane resolves, checks and stamps in its own.
                llm_prepare "$PWD"
                llm_apply
                exec "${CLAUDE_CMD[@]}"
            fi
            # Refused here, before any session vehicle is touched. A
            # directory that does not exist is start_session's error; one
            # it cannot enter is refused, its .cct.toml being unreadable.
            if [[ -d "${1:-.}" ]]; then
                llm_project=$(cd "${1:-.}" 2>/dev/null && pwd) \
                    || llm_refuse "cannot enter ${1:-.}, so its project's restriction cannot be read"
                llm_prepare "$llm_project"
            fi
        else
            llm_unpinned_notice ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
            # The notice belongs where a session is about to start, not on
            # help or list (review of PR #425). It describes the shell's
            # own gateway variables, which a selected launch replaces.
            gateway_compat_notice
        fi
        start_session "${1:-}"
        ;;
esac
