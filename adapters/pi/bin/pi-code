#!/usr/bin/env bash
# pi-code — Code Copilot Team launcher for the Pi coding agent (CCT-MANAGED)
#
# Wraps the upstream `pi` executable and starts it with the CCT enforcement
# runtime explicitly loaded. Bare `pi` remains an unenforced Pi environment.
#
#   pi install git:...  gives reusable CCT content (advisory mode);
#   pi-code             gives the enforced CCT harness.
#
# Usage:
#   pi-code [CCT_OPTIONS] [PROJECT_PATH] [-- PI_ARGUMENTS]
#   pi-code <COMMAND> [ARGS]
#
# Commands:
#   version               Print pi-code, CCT, and pi versions
#   doctor [--json]       Installation and configuration diagnostics
#   config [--json]       Print the resolved configuration (redacted)
#   config explain <key>  Show a key's value and the layers that set it
#   features [--json]     Report capability state (kind x runtime status)
#   export [--json]       Redacted, portable snapshot of the resolved config
#   resources [--json]    Report which source supplied each skill/prompt
#   provenance [--json]   FR-027 report: version, source, capability + trust posture
#   continuity [--json]   Durable resume state: SDD tasks, checkpoint, auto-build ledger
#   worktree create <workerId> --branch <b> [--base <ref>] [--path <dir>] [--tasks a,b] [--areas x,y]
#                         Provision a worker git worktree + ledger record (pre-spawn); prints the path
#   worktree run <workerId> --branch <b> [prov flags] [-- <pi args>]
#                         Provision AND launch pi inside the new worktree (one shot)
#   team status|synthesize [--json]
#                         Read-only team coordination snapshot (opt-in: agents.teams_enabled)
#   env scrub-list [--json]
#                         Env names the worktree-run handoff scrubs (#173; single TS pattern source)
#   init [dir] [--profile <name>] [--dry-run] [--extension-template]
#                         Scaffold a Pi-native project config + ownership manifest;
#                         --extension-template adds .pi/extensions/ guardrails starter (#179)
#   sync [--dry-run]      Regenerate managed resources (never touches your config)
#   help                  Show usage
#
# Diagnostics resolve project config as untrusted: they run outside a Pi
# session, where isProjectTrusted() is unavailable (fail-closed, C-3).
#
# Options (Phase 0 subset):
#   --profile <name>      Select a CCT profile (recorded; enforced by runtime)
#   --project <path>      Select the working project directory
#   --no-cct              Start upstream pi without the CCT runtime (reported)
#   --diagnostic          Print detailed startup resolution to stderr
#   --                    Pass all remaining arguments directly to pi
#
# Design contract (specs/pi-harness-adoption/spec.md FR-000/FR-002):
#   - Never reads project CCT configuration (trust is resolved in-process
#     by the runtime via Pi's project_trust lifecycle).
#   - Sets CCT_RUNTIME=1 only when the enforcement runtime is loaded.
#   - Forwards unknown arguments to pi unmodified; preserves exit codes
#     and signals (exec).

set -euo pipefail

PI_CODE_VERSION="1.1.0"
# Authoritative runtime provenance version (read by `pi-code provenance`). The
# launcher owns it; a managed install has no package.json, so env is the source.
export CCT_VERSION="$PI_CODE_VERSION"
SELF_PATH="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"

# Managed install layout (populated by adapters/pi/setup.sh). When running
# from the repo checkout, fall back to the adapter directory itself.
CCT_HOME="${CCT_HOME:-$HOME/.code-copilot-team}"
MANAGED_DIR="$CCT_HOME/pi"
REPO_ADAPTER_DIR="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd || true)"

RUNTIME_ENTRY=""
for candidate in "$MANAGED_DIR/runtime/index.ts" "$REPO_ADAPTER_DIR/runtime/index.ts"; do
  if [[ -n "$candidate" && -f "$candidate" ]]; then
    RUNTIME_ENTRY="$candidate"
    break
  fi
done

COMPAT_FILE=""
for candidate in "$MANAGED_DIR/compat.env" "$REPO_ADAPTER_DIR/compat.env"; do
  if [[ -n "$candidate" && -f "$candidate" ]]; then
    COMPAT_FILE="$candidate"
    break
  fi
done

CCT_PI_MIN_VERSION="0.79.0"
if [[ -n "$COMPAT_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$COMPAT_FILE"
fi

err()  { echo "[pi-code] ERROR: $*" >&2; }
warn() { echo "[pi-code] WARN:  $*" >&2; }
diag() { [[ "${DIAGNOSTIC:-false}" == "true" ]] && echo "[pi-code] $*" >&2 || true; }

# ── Recursion guard ─────────────────────────────────────────
# A pi-code-launched session (or a reviewer child) must not re-enter the
# launcher and stack runtimes. CCT_PI_CODE_ACTIVE marks an active launch.
case "${1:-}" in
  version|help|--help|-h|doctor|config|features|export|resources|provenance|continuity|worktree|team|env|init|sync) CCT_DIAGNOSTIC_CMD=true ;;
  *) CCT_DIAGNOSTIC_CMD=false ;;
esac
if [[ "${CCT_PI_CODE_ACTIVE:-}" == "1" && "$CCT_DIAGNOSTIC_CMD" == "false" ]]; then
  err "recursive pi-code invocation detected (CCT_PI_CODE_ACTIVE=1)."
  err "Inside a pi-code session, use 'pi' directly or 'pi-code --no-cct'."
  exit 64
fi

# ── Upstream pi resolution ──────────────────────────────────
resolve_pi() {
  # Find the first `pi` on PATH that is not this launcher (or a copy of it).
  local IFS=':' dir cand
  for dir in $PATH; do
    cand="$dir/pi"
    [[ -x "$cand" ]] || continue
    [[ "$cand" -ef "$SELF_PATH" ]] && continue
    # Refuse a pi that is actually a CCT-managed shim.
    if head -3 "$cand" 2>/dev/null | grep -q "CCT-MANAGED"; then
      continue
    fi
    echo "$cand"
    return 0
  done
  return 1
}

pi_version_of() {
  "$1" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true
}

# version_ge A B → 0 if A >= B (numeric, three components)
version_ge() {
  [[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" == "$2" ]]
}

# ── init / sync (T6.4, FR-000a) ─────────────────────────────
# init scaffolds ONLY the Pi-native project footprint; sync reuses Pi's
# LITERAL managed-resource contract. Neither touches user config once written.
# Design: specs/pi-harness-adoption/design-t64-init-sync.md.

# Portable content hash (sha256 preferred; first field only).
hash_file() {
  if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
  elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  elif command -v md5 >/dev/null 2>&1; then md5 -q "$1"
  else md5sum "$1" | awk '{print $1}'; fi
}

# Starter config.toml (commented defaults — a starting point, enforces nothing
# unexpected). $1 = profile name or "" (uncomments the profile line when set).
starter_config() {
  local prof="$1"
  echo "# Code Copilot Team — Pi project configuration (created by 'pi-code init')."
  echo "# Edit freely: 'pi-code sync' NEVER overwrites this file. It is layered under"
  echo "# the global config; inspect a key with 'pi-code config explain <dotted.key>'."
  echo ""
  if [[ -n "$prof" ]]; then echo "profile = \"$prof\""; else echo "# profile = \"disciplined\""; fi
  echo ""
  echo "[workflow.sdd]"
  echo "# enabled = true"
  echo ""
  echo "[review]"
  echo "# mandatory = false"
  echo ""
  echo "[verification]"
  echo "# required = []"
}

# Resolve the extension-template source dir (managed install first, repo
# fallback) — #179. Empty when neither exists.
extension_template_src() {
  # A candidate must carry the COMPLETE file set — a stale managed install
  # (e.g. from a mid-development window) falls through to the repo copy
  # instead of producing a partial scaffold (review P1).
  local cand f complete
  for cand in "$MANAGED_DIR/resources/extension-template" "$REPO_ADAPTER_DIR/resources/extension-template"; do
    complete=true
    for f in cct-guardrails.ts README.md tsconfig.json validators/check-python-ast.py; do
      [[ -f "$cand/$f" ]] || { complete=false; break; }
    done
    if [[ "$complete" == "true" ]]; then echo "$cand"; return 0; fi
  done
  echo ""
}

# Copy one template file if absent (init NEVER clobbers); echo the manifest
# entry on create, nothing on preserve.
scaffold_ext_file() {
  local src="$1" dest="$2" rel="$3"
  if [[ -f "$dest" ]]; then
    echo "[pi-code]   $rel exists — preserved (init never clobbers; a deleted template file IS restored)." >&2
    return 0
  fi
  # Fail LOUDLY: a copy or hash failure must abort the scaffold, never emit
  # a manifest entry for a file that does not exist (review P1).
  mkdir -p "$(dirname "$dest")" || { err "init: cannot create $(dirname "$dest")"; return 1; }
  cp "$src" "$dest" || { err "init: cannot copy $rel from $src"; return 1; }
  local h
  h="$(hash_file "$dest")" || { err "init: cannot hash $rel"; return 1; }
  [[ -n "$h" ]] || { err "init: empty hash for $rel"; return 1; }
  printf '    { "path": "%s", "kind": "extension-template", "hash": "%s" }' "$rel" "$h"
}

cct_init() {
  local proj="" prof="" dry=false ext_tpl=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run)   dry=true; shift ;;
      --extension-template) ext_tpl=true; shift ;;
      --profile)   prof="${2:?--profile requires a name}"; shift 2 ;;
      --profile=*) prof="${1#*=}"; shift ;;
      -*)          err "unknown init option: $1"; return 2 ;;
      *)           if [[ -z "$proj" ]]; then proj="$1"; shift
                   else err "init: unexpected argument '$1'"; return 2; fi ;;
    esac
  done
  [[ -n "$proj" ]] || proj="."
  [[ -d "$proj" ]] || { err "init: project directory not found: $proj"; return 2; }
  local cfgdir cfg mani
  cfgdir="$proj/.code-copilot-team"; cfg="$cfgdir/config.toml"; mani="$cfgdir/.cct-init.json"
  if [[ -f "$cfg" ]]; then
    echo "[pi-code] already initialized — $cfg preserved (init never clobbers your config)."
    if [[ "$ext_tpl" == "true" ]]; then
      # capture (and drop) the manifest fragments — a pre-existing manifest
      # is not rewritten; files are still scaffolded no-clobber.
      local _ext_ignored
      _ext_ignored="$(scaffold_extension_into "$proj" "$dry")" || return $?
      echo "[pi-code] note: pre-existing init — $mani not rewritten for the template files."
    fi
    return 0
  fi
  if [[ "$dry" == "true" ]]; then
    echo "[pi-code] init --dry-run (report only — no writes):"
    echo "  would create $cfg"
    echo "  would create $mani"
    if [[ "$ext_tpl" == "true" ]]; then
      echo "  would create $proj/.pi/extensions/cct-guardrails.ts"
      echo "  would create $proj/.pi/extensions/README.md"
      echo "  would create $proj/.pi/extensions/tsconfig.json"
      echo "  would create $proj/.pi/extensions/validators/check-python-ast.py"
    fi
    return 0
  fi
  mkdir -p "$cfgdir"
  starter_config "$prof" > "$cfg"
  local h ts
  h="$(hash_file "$cfg")"
  ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  local ext_entries=""
  if [[ "$ext_tpl" == "true" ]]; then
    ext_entries="$(scaffold_extension_into "$proj" false)" || return $?
  fi
  cat > "$mani" <<JSON
{
  "name": "${prof:-default}",
  "initialized": "$ts",
  "cctVersion": "$PI_CODE_VERSION",
  "generated": [
    { "path": ".code-copilot-team/config.toml", "kind": "user-config", "hash": "$h" }${ext_entries:+,
$ext_entries}
  ]
}
JSON
  echo "[pi-code] initialized $cfgdir"
  echo "  created $cfg (yours to edit; sync never overwrites it)"
  echo "  created $mani (ownership manifest)"
}

# Scaffold the #179 guardrails template into <proj>/.pi/extensions/.
# stdout: comma-joined manifest entry lines for files CREATED (empty when
# everything already existed); human notes go to stderr. $2=true => dry.
scaffold_extension_into() {
  local proj="$1" dry="$2" src entries="" e
  src="$(extension_template_src)"
  if [[ -z "$src" ]]; then
    err "init: extension template not found (reinstall with setup.sh, or run from the CCT repo)."
    return 78
  fi
  if [[ "$dry" == "true" ]]; then
    echo "[pi-code] would scaffold .pi/extensions/ from $src" >&2
    return 0
  fi
  local pairs=(
    "cct-guardrails.ts|.pi/extensions/cct-guardrails.ts"
    "README.md|.pi/extensions/README.md"
    "tsconfig.json|.pi/extensions/tsconfig.json"
    "validators/check-python-ast.py|.pi/extensions/validators/check-python-ast.py"
  )
  local pair rel srcf
  for pair in "${pairs[@]}"; do
    srcf="${pair%%|*}"; rel="${pair##*|}"
    e="$(scaffold_ext_file "$src/$srcf" "$proj/$rel" "$rel")" || return $?
    if [[ -n "$e" ]]; then
      entries="${entries:+$entries,
}$e"
    fi
  done
  echo "[pi-code] scaffolded .pi/extensions/ (guardrails starter — see its README)" >&2
  [[ -n "$entries" ]] && printf '%s' "$entries"
  return 0
}

cct_sync() {
  local dry=false
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry=true; shift ;;
      -*)        err "unknown sync option: $1"; return 2 ;;
      *)         err "sync takes no positional arguments (got '$1')"; return 2 ;;
    esac
  done
  # Locate the CCT repo — sync reuses the repo's generate.sh + setup.sh --sync
  # (Pi has no scaffolded project content to diff; managed resources live here).
  local repo=""
  if [[ -n "${CCT_REPO_DIR:-}" && -f "$CCT_REPO_DIR/scripts/generate.sh" ]]; then
    repo="$CCT_REPO_DIR"
  elif [[ -f "$REPO_ADAPTER_DIR/setup.sh" && -f "$REPO_ADAPTER_DIR/../../scripts/generate.sh" ]]; then
    repo="$(cd "$REPO_ADAPTER_DIR/../.." && pwd)"
  fi
  if [[ -z "$repo" ]]; then
    err "sync needs the CCT repo checkout (run pi-code from the repo, or set CCT_REPO_DIR)."
    return 78
  fi
  if [[ "$dry" == "true" ]]; then
    echo "[pi-code] sync --dry-run (report only — no writes, no staging, no git add):"
    echo "  would run: bash $repo/adapters/pi/setup.sh --sync"
    echo "             (regenerates adapters/pi/resources via generate.sh, then reinstalls)"
    # Read-only drift status when the repo is a git checkout — never stages.
    if command -v git >/dev/null 2>&1 && git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
      local drift
      drift="$(git -C "$repo" status --porcelain adapters/pi/resources 2>/dev/null || true)"
      if [[ -n "$drift" ]]; then
        echo "  current generated-resource drift:"
        echo "$drift" | sed 's/^/    /'
      else
        echo "  generated resources currently in sync"
      fi
    fi
    return 0
  fi
  echo "[pi-code] sync: regenerating managed resources + reinstalling (setup.sh --sync)"
  bash "$repo/adapters/pi/setup.sh" --sync
}

# `worktree run` — provision a worker worktree AND launch pi INSIDE it in one
# step (the atomic provision+spawn happy path). Splits args at `--`: before it
# are the `worktree create` provisioning flags; after it are pi arguments.
# Re-execs the launcher with --project <worktree> so the child pi starts with
# cwd = the worktree, and exports the CCT_WORKER_* contract so session_start
# validates isolation.
cct_worktree_run() {
  local prov=() pia=() seen_dd=false a
  for a in "$@"; do
    if ! $seen_dd && [[ "$a" == "--" ]]; then seen_dd=true; continue; fi
    if $seen_dd; then pia+=("$a"); else prov+=("$a"); fi
  done
  if [[ ${#prov[@]} -eq 0 ]]; then
    err "usage: pi-code worktree run <workerId> --branch <b> [prov flags] [-- <pi args>]"
    return 64
  fi
  # Pull workerId (first non-flag) + branch/base/... for the worker env.
  local wid="" wbranch="" wbase="" wpath="" wareas="" wtasks="" wfeature="" i=0
  while [[ $i -lt ${#prov[@]} ]]; do
    case "${prov[$i]}" in
      --branch)  wbranch="${prov[$((i+1))]:-}";  i=$((i+2)) ;;
      --base)    wbase="${prov[$((i+1))]:-}";    i=$((i+2)) ;;
      --path)    wpath="${prov[$((i+1))]:-}";    i=$((i+2)) ;;
      --areas)   wareas="${prov[$((i+1))]:-}";   i=$((i+2)) ;;
      --tasks)   wtasks="${prov[$((i+1))]:-}";   i=$((i+2)) ;;
      --feature) wfeature="${prov[$((i+1))]:-}"; i=$((i+2)) ;;
      --*)       i=$((i+1)) ;;
      *)         [[ -z "$wid" ]] && wid="${prov[$i]}"; i=$((i+1)) ;;
    esac
  done
  if [[ -z "$wid" || -z "$wbranch" ]]; then
    err "worktree run requires <workerId> and --branch"
    return 64
  fi
  # SECURITY (defense 1, pre-provision): the forwarded pi args re-enter the
  # launcher's own option parser in the child. Reject the ones that would break
  # the isolation contract BEFORE provisioning (so an invalid launch leaves no
  # orphaned worktree): --project would move the worker OUT of its worktree and
  # --no-cct would disable enforcement. Only the launcher-consumed portion (up to
  # the first `--`, after which args go to pi) is scanned. The locked-path check
  # in the child (defense 2) is the authoritative backstop.
  local pa
  for pa in ${pia[@]+"${pia[@]}"}; do
    [[ "$pa" == "--" ]] && break
    case "$pa" in
      --project|--project=*|--no-cct)
        err "worktree run: forwarded option '$pa' is not allowed — it would break worktree isolation."
        err "Provide pi arguments after '--'; the worktree cwd and enforcement are fixed."
        return 64 ;;
    esac
  done
  # #173 (FR-4/FR-5): resolve the scrub list BEFORE provisioning, so a
  # scrub-list failure refuses the handoff with NO git side effects (same
  # invariant as the pre-provision escape checks above). The list comes from
  # the runtime CLI — the single TS pattern source, resolved at global/env/
  # cli scope (project config is never read untrusted). Text protocol: one
  # name per line, or an '=disabled=<layer>' marker (unforgeable — an env
  # var NAME can never contain '='). stdout is parsed; stderr is surfaced
  # only on failure (never fed to the parser).
  local scrub_out scrub_rc=0 scrub_names="" scrub_off_layer="" sn
  local SCRUB_U=()
  local scrub_errf
  # Preflight the exec vehicle too (review F7): the final launch goes through
  # /usr/bin/env -u, and this is the last point where refusal is side-effect
  # free.
  if [[ ! -x /usr/bin/env ]]; then
    err "worktree run: /usr/bin/env not executable — refusing an unscrubbed handoff."
    return 1
  fi
  scrub_errf="$(mktemp "${TMPDIR:-/tmp}/cct-scrub-err.XXXXXX")" || scrub_errf=""
  scrub_out="$("$SELF_PATH" env scrub-list 2>"${scrub_errf:-/dev/null}")" || scrub_rc=$?
  if [[ $scrub_rc -ne 0 ]]; then
    err "worktree run: 'pi-code env scrub-list' failed — refusing an unscrubbed handoff."
    [[ -n "$scrub_errf" && -s "$scrub_errf" ]] && err "$(cat "$scrub_errf")"
    [[ -n "$scrub_errf" ]] && rm -f "$scrub_errf"
    return 1
  fi
  [[ -n "$scrub_errf" ]] && rm -f "$scrub_errf"
  while IFS= read -r sn; do
    sn="${sn%$'\r'}"
    [[ -z "$sn" ]] && continue
    case "$sn" in
      # The disabled marker embeds '=' — unforgeable, since an env var NAME
      # can never contain '=' (a '#'-style marker would be spoofable).
      "=disabled="*) scrub_off_layer="${sn#=disabled=}"; continue ;;
      *=*)
        err "worktree run: malformed scrub-list entry — refusing the handoff."
        return 1 ;;
    esac
    SCRUB_U+=(-u "$sn")
    scrub_names="${scrub_names:+$scrub_names,}$sn"
  done <<< "$scrub_out"
  # Provision (prints ONLY the worktree path on success; error text on failure).
  local wt
  wt="$("$SELF_PATH" worktree create "${prov[@]}")" || { err "worktree run: provisioning failed: $wt"; return 1; }
  if [[ -z "$wt" ]]; then err "worktree run: provisioning produced no path"; return 1; fi
  # Export the untrusted CCT_WORKER_* signal contract for isolation validation.
  export CCT_WORKER_ID="$wid" CCT_WORKER_BRANCH="$wbranch"
  [[ -n "$wbase" ]]    && export CCT_WORKER_BASE="$wbase"
  [[ -n "$wpath" ]]    && export CCT_WORKER_PATH="$wpath"
  [[ -n "$wareas" ]]   && export CCT_WORKER_AREAS="$wareas"
  [[ -n "$wtasks" ]]   && export CCT_WORKER_TASKS="$wtasks"
  [[ -n "$wfeature" ]] && export CCT_FEATURE_ID="$wfeature"
  # Launch pi INSIDE the worktree via the normal launch path (--project cds there).
  # A controller session sets CCT_PI_CODE_ACTIVE=1; this child worker is an
  # INTENTIONAL handoff (a fresh, independently-enforced worker launch), not the
  # accidental runtime-stacking the recursion guard defends against. Clear the
  # marker for THIS one exec so the guard permits it — the child launcher re-sets
  # it right before exec'ing pi. Targeted, not a broad weakening of the guard.
  # CCT_LOCKED_PROJECT_PATH pins the worktree cwd + enforcement for the child
  # (defense 2): even though forwarded args re-enter the public parser, the child
  # refuses to launch anywhere other than "$wt" or with --no-cct.
  # The two signal vars are mutually exclusive; clear the counterpart so a
  # stale inherited value (e.g. a controller launched while scrubbing was
  # off) cannot misrecord this handoff (review F2/F3 of the final round).
  if [[ -n "$scrub_off_layer" ]]; then
    unset CCT_ENV_SCRUBBED
    export CCT_ENV_SCRUB_OFF="$scrub_off_layer"
  else
    # Always exported when scrubbing ran — an empty value is an auditable
    # "scrub ran, nothing matched" (never silence; phase-2 review F3).
    unset CCT_ENV_SCRUB_OFF
    export CCT_ENV_SCRUBBED="$scrub_names"
  fi
  unset CCT_PI_CODE_ACTIVE
  export CCT_LOCKED_PROJECT_PATH="$wt"
  # exec via env -u: EVERY listed name is removed, including names that are
  # not shell identifiers (bash `unset` cannot touch those — phase-2 review
  # F1's proven leak). env execs the launcher, preserving exit/signals.
  exec /usr/bin/env ${SCRUB_U[@]+"${SCRUB_U[@]}"} "$SELF_PATH" --project "$wt" ${pia[@]+"${pia[@]}"}
}

# ── Parse CCT options ───────────────────────────────────────
PROFILE="${CCT_PROFILE:-disciplined}"
PROJECT_PATH=""
NO_CCT=false
NO_PROJECT_CONFIG=false
DIAGNOSTIC=false
CLI_SETS=""
PEER_ENABLED=""      # "" = unset (neither --peer-review nor --peer-review-off)
PEER_PROVIDER=""
PEER_SCOPE="both"
PI_ARGS=()

# `worktree run` provisions AND launches inside the worktree (one shot).
if [[ "${1:-}" == "worktree" && "${2:-}" == "run" ]]; then
  cct_worktree_run "${@:3}"
  exit $?
fi

case "${1:-}" in
  version)
    echo "pi-code $PI_CODE_VERSION (Code Copilot Team)"
    if PI_BIN="$(resolve_pi)"; then
      echo "pi $(pi_version_of "$PI_BIN") ($PI_BIN)"
    else
      echo "pi (not found on PATH)"
    fi
    echo "runtime ${RUNTIME_ENTRY:-<not installed>}"
    echo "minimum supported pi: $CCT_PI_MIN_VERSION"
    exit 0
    ;;
  help|--help|-h)
    sed -n '2,46p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  config|features|export|resources|provenance|continuity|worktree|team|env)
    # Diagnostics run outside a Pi session; the runtime CLI resolves and
    # reports configuration and capability state (fail-closed on trust).
    if [[ -z "$RUNTIME_ENTRY" ]]; then
      err "enforcement runtime not found — run ./scripts/setup.sh --pi"
      exit 78
    fi
    if ! command -v node >/dev/null 2>&1; then
      err "node is required for '$1' (>= 22.6 for TypeScript stripping)"
      exit 127
    fi
    CLI_ENTRY="$(dirname "$RUNTIME_ENTRY")/cli.ts"
    if [[ ! -f "$CLI_ENTRY" ]]; then
      err "diagnostic CLI not found at $CLI_ENTRY — reinstall with ./adapters/pi/setup.sh --repair"
      exit 78
    fi
    CCT_RUNTIME_ENTRY="$RUNTIME_ENTRY" exec node --no-warnings --experimental-strip-types "$CLI_ENTRY" "$@"
    ;;
  init)
    cct_init "${@:2}" && exit 0 || exit $?
    ;;
  sync)
    cct_sync "${@:2}" && exit 0 || exit $?
    ;;
  doctor)
    # --json defers to the runtime CLI, which can report resolved
    # configuration; the shell path stays for a runtime-less install.
    if [[ "${2:-}" == "--json" && -n "$RUNTIME_ENTRY" ]] && command -v node >/dev/null 2>&1; then
      CLI_ENTRY="$(dirname "$RUNTIME_ENTRY")/cli.ts"
      if [[ -f "$CLI_ENTRY" ]]; then
        CCT_RUNTIME_ENTRY="$RUNTIME_ENTRY" exec node --no-warnings --experimental-strip-types "$CLI_ENTRY" "$@"
      fi
    fi
    STATUS=0
    echo "=== pi-code doctor (Phase 0) ==="
    if PI_BIN="$(resolve_pi)"; then
      PV="$(pi_version_of "$PI_BIN")"
      echo "[ok]   upstream pi: $PI_BIN (version ${PV:-unknown})"
      if [[ -n "$PV" ]] && ! version_ge "$PV" "$CCT_PI_MIN_VERSION"; then
        echo "[fail] pi $PV < minimum supported $CCT_PI_MIN_VERSION"
        STATUS=1
      fi
    else
      echo "[fail] upstream pi not found on PATH (install: npm i -g @earendil-works/pi-coding-agent)"
      STATUS=1
    fi
    if [[ -n "$RUNTIME_ENTRY" ]]; then
      echo "[ok]   enforcement runtime: $RUNTIME_ENTRY"
    else
      echo "[fail] enforcement runtime not found (run ./scripts/setup.sh --pi)"
      STATUS=1
    fi
    if [[ -d "$MANAGED_DIR/resources/skills" ]]; then
      echo "[ok]   advisory resources: $MANAGED_DIR/resources"
    else
      echo "[warn] managed advisory resources not installed (advisory mode may still be provided via 'pi install')"
    fi
    echo "note: run 'pi-code doctor --json', 'pi-code config', or 'pi-code features'"
    echo "      for configuration, provenance, and capability state."
    exit "$STATUS"
    ;;
esac

while [[ $# -gt 0 ]]; do
  case "$1" in
    --profile)     PROFILE="${2:?--profile requires a name}"; shift 2 ;;
    --project)     PROJECT_PATH="${2:?--project requires a path}"; shift 2 ;;
    --no-cct)      NO_CCT=true; shift ;;
    --no-project-config|--global) NO_PROJECT_CONFIG=true; shift ;;
    --set)
      SET_ENTRY="${2:?--set requires key=value}"
      if [[ -n "$CLI_SETS" ]]; then CLI_SETS="$CLI_SETS"$'\n'"$SET_ENTRY"; else CLI_SETS="$SET_ENTRY"; fi
      shift 2
      ;;
    --diagnostic)  DIAGNOSTIC=true; shift ;;
    --)            shift; PI_ARGS+=("$@"); break ;;
    --peer-review)
      PEER_ENABLED=true
      # Optional provider (mirror Claude): consume $2 only if it is not a
      # flag, a path, or a directory — else `--peer-review /proj` would eat it.
      if [[ -n "${2:-}" && "${2#-}" == "$2" && "$2" != */* && ! -d "$2" ]]; then
        PEER_PROVIDER="$2"; shift
      fi
      shift ;;
    --peer-review=*)      PEER_ENABLED=true; PEER_PROVIDER="${1#*=}"; shift ;;
    --peer-review-off)    PEER_ENABLED=false; shift ;;
    --peer-review-scope)  PEER_SCOPE="${2:?--peer-review-scope requires code|design|both}"; shift 2 ;;
    --peer-review-scope=*) PEER_SCOPE="${1#*=}"; shift ;;
    -*)            PI_ARGS+=("$1"); shift ;;   # unknown option → forward to pi
    *)
      if [[ -z "$PROJECT_PATH" && -d "$1" ]]; then
        PROJECT_PATH="$1"
      else
        PI_ARGS+=("$1")
      fi
      shift
      ;;
  esac
done

# Validate the peer-review scope (fail-fast; Claude leaves it unvalidated).
case "$PEER_SCOPE" in
  code|design|both) ;;
  *) err "--peer-review-scope must be code|design|both (got '$PEER_SCOPE')"; exit 2 ;;
esac

# The launcher OWNS the peer-review env: clear any AMBIENT CCT_PEER_* so only
# these flags (or their absence) reach Pi. Ambient shell values must never be a
# backdoor that bypasses the mandatory-review gate (guardrail A). The enforced
# export block below re-sets them from the parsed flags.
unset CCT_PEER_REVIEW_ENABLED CCT_PEER_PROVIDER CCT_PEER_REVIEW_SCOPE

# SECURITY (defense 2 — worktree run handoff): when a locked-project handoff is
# in effect, the worker MUST launch inside exactly that worktree, enforced.
# Forwarded args re-enter this parser, so re-validate the FINAL state here: an
# overridden --project or a --no-cct is refused. This backstops the pre-provision
# scan in cct_worktree_run and makes the public parser safe for the handoff.
# Setting CCT_LOCKED_PROJECT_PATH externally can only RESTRICT a launch (fail
# closed), never bypass anything.
if [[ -n "${CCT_LOCKED_PROJECT_PATH:-}" ]]; then
  if $NO_CCT; then
    err "worktree run: --no-cct is not allowed for an enforced worker launch."
    exit 64
  fi
  _cct_locked="$(cd "$CCT_LOCKED_PROJECT_PATH" 2>/dev/null && pwd -P || echo "$CCT_LOCKED_PROJECT_PATH")"
  _cct_proj="$(cd "${PROJECT_PATH:-.}" 2>/dev/null && pwd -P || echo "${PROJECT_PATH:-}")"
  if [[ "$_cct_proj" != "$_cct_locked" ]]; then
    err "worktree run: refusing to launch outside the allocated worktree"
    err "  requested: ${PROJECT_PATH:-<none>}"
    err "  allocated: $CCT_LOCKED_PROJECT_PATH"
    exit 64
  fi
  PROJECT_PATH="$_cct_locked"
  unset CCT_LOCKED_PROJECT_PATH   # do not leak the internal lock into pi's env
fi

# ── Launch ──────────────────────────────────────────────────
if ! PI_BIN="$(resolve_pi)"; then
  err "upstream pi not found on PATH."
  err "Install it first: npm install -g @earendil-works/pi-coding-agent"
  exit 127
fi

PV="$(pi_version_of "$PI_BIN")"
if [[ -n "$PV" ]] && ! version_ge "$PV" "$CCT_PI_MIN_VERSION"; then
  err "pi $PV is older than the minimum supported $CCT_PI_MIN_VERSION."
  err "Upgrade pi, or run bare 'pi' for an unenforced session."
  exit 65
fi

if [[ -n "$PROJECT_PATH" ]]; then
  cd "$PROJECT_PATH" || { err "cannot cd to project: $PROJECT_PATH"; exit 66; }
fi

diag "pi:       $PI_BIN (version ${PV:-unknown})"
diag "profile:  $PROFILE"
diag "project:  ${PROJECT_PATH:-$PWD}"
diag "runtime:  ${RUNTIME_ENTRY:-<none>}"
diag "args:     ${PI_ARGS[*]:-<none>}"

if $NO_CCT; then
  # Equivalent to bare pi: no runtime, no marker. Reported visibly so an
  # unenforced session is never mistaken for an enforced one (FR-002).
  warn "--no-cct: starting UNENFORCED pi (no CCT runtime, gates, or policies)."
  # ${a[@]+"${a[@]}"} — bash 3.2 (macOS /bin/bash) treats "${a[@]}" on an
  # empty array as unbound under `set -u`.
  exec "$PI_BIN" ${PI_ARGS[@]+"${PI_ARGS[@]}"}
fi

if [[ -z "$RUNTIME_ENTRY" ]]; then
  err "CCT enforcement runtime not found."
  err "Run ./scripts/setup.sh --pi (or use pi-code --no-cct for plain pi)."
  exit 78
fi

# Derive the Pi invocation mode from the forwarded args (T5.4). The runtime
# reads CCT_PI_MODE as the authoritative label for audit/reporting — Pi's
# extension ctx.mode is not relied on for this. Decision behavior is unchanged:
# only a real interactive UI (ctx.ui.confirm) can prompt; print/json/rpc are
# headless and resolve deterministically. Default `tui` = no headless flag.
# A space-padded join + case match keeps this simple and bash-3.2 safe (a
# per-element loop tripped a set -e / $? fragility in command substitution).
CCT_PI_MODE=tui
_pi_argstr=" ${PI_ARGS[*]:-} "
case "$_pi_argstr" in
  *" --mode json "*|*" --mode=json "*)                 CCT_PI_MODE=json ;;
  *" --mode rpc "*|*" --mode=rpc "*)                   CCT_PI_MODE=rpc ;;
  *" -p "*|*" --print "*|*" --mode print "*|*" --mode=print "*) CCT_PI_MODE=print ;;
esac

export CCT_RUNTIME=1
export CCT_PI_CODE_ACTIVE=1
export CCT_PROFILE="$PROFILE"
export CCT_PI_MODE
[[ -n "$CLI_SETS" ]] && export CCT_CLI_SETS="$CLI_SETS"
$NO_PROJECT_CONFIG && export CCT_NO_PROJECT_CONFIG=1
# Peer-review session contract (FR-000a). Session intent only — read by
# /cct:review-submit; never mutates persisted config. Enforced path only.
[[ -n "$PEER_ENABLED" ]] && export CCT_PEER_REVIEW_ENABLED="$PEER_ENABLED"
if [[ "$PEER_ENABLED" == "true" ]]; then
  [[ -n "$PEER_PROVIDER" ]] && export CCT_PEER_PROVIDER="$PEER_PROVIDER"
  export CCT_PEER_REVIEW_SCOPE="$PEER_SCOPE"
fi
exec "$PI_BIN" --extension "$RUNTIME_ENTRY" ${PI_ARGS[@]+"${PI_ARGS[@]}"}
