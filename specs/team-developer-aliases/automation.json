{
  "schema_version": 2,
  "profile": "unattended",
  "branch": {
    "name": "feature/team-developer-aliases-run4",
    "base": "master",
    "remote": "origin"
  },
  "phases": {
    "source": "tasks.md",
    "milestone_every": 8,
    "max_phases": 2
  },
  "build": {
    "max_turns": 80,
    "permission_mode": "acceptEdits",
    "max_fix_sessions_per_phase": 2
  },
  "test": {
    "command": "env PYTHONPATH=scripts:. python3 -m pytest scripts/session_analytics/tests -q -p no:cacheprovider --deselect scripts/session_analytics/tests/test_cli.py::TestCli::test_ingest_requires_dsn",
    "timeout_sec": 900
  },
  "review": {
    "reviewers": [
      {
        "provider": "spark",
        "specialization": "correctness",
        "scope": "both",
        "gating": true
      }
    ],
    "max_rounds": 3,
    "round_timeout_sec": 900,
    "loop_timeout_sec": 600
  },
  "caps": {
    "wall_clock_sec": 5400,
    "cost_usd": 10
  },
  "unattended": {
    "on_review_breaker": "terminate",
    "on_stale_finding": "terminate",
    "on_origin_gate": "terminate",
    "budget": {
      "meter_all_invocations": true,
      "estimate_unmetered": true,
      "estimate_usd_per_invocation": 2.0
    }
  },
  "notify": {
    "command": ""
  },
  "pr": {
    "closes": [],
    "title": "feat(session-analytics): developer aliases for the team store [auto-build]"
  },
  "merge": {
    "enabled": false,
    "require_green_ci": true,
    "require_branch_protection": true,
    "method": "squash"
  }
}
