#!/usr/bin/env bash
# wiki-ingest — backwards-compatible alias for the v1 single-source
# proposal generator (#384, FR-4).
#
# Every existing invocation keeps working unchanged:
#   ./scripts/wiki-ingest <source>
#   ./scripts/wiki-ingest --backend test --dry-run --output-dir <dir> <source>
#
# It is exactly `./scripts/wiki ingest --legacy-single-source "$@"`: the
# arguments, exit status, stdout and stderr are the launcher's, and the
# launcher's environment checks apply. There is no engine code here.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "$0")/.." && pwd)"
exec "$REPO_DIR/scripts/wiki" ingest --legacy-single-source "$@"
