#!/usr/bin/env bash
# cct — unified command-line front door for code-copilot-team.
#
# One discoverable entry point for finding and validating everything the
# harness offers. Add it to PATH (or call scripts/cct) and run `cct help`.
#
#   cct start [path] [...] start a harness session (the claude-code launcher)
#   cct init <type> [path] create a project from a template
#   cct templates          the templates init accepts, then the add-ons
#   cct sync [path]        update a project from its template
#   cct build <id> [...]   build an approved feature unattended
#   cct permissions <tier> set a project's permission tier
#   cct playwright [path]  install the Playwright CLI skills into a project
#   cct features [...]     what the harness offers: maturity, adapters, guides
#   cct list [--write]     browse every feature, slash command, skill, and capability
#   cct doctor [...]       is this machine ready? tools, providers, adapters
#   cct config <...>       validate the configuration, or explain one key
#   cct home [migrate]     where CCT keeps this user's files; move a legacy home
#   cct llm <...>          the LLM catalog: the targets `cct start --llm` accepts
#   cct harness explain    what a `--llm` launch would set and remove, before it runs
#   cct help               show this help
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
cct — code-copilot-team CLI

USAGE
  cct <command> [options]

COMMANDS
  start           Start a harness session in a project. Runs the installed
                  claude-code launcher (per-project cmux/tmux session, transcript
                  log, peer-review flags), so every launcher argument passes through.
                    cct start                        this directory
                    cct start ~/projects/my-app      that project
                    cct start --peer-review <name> ~/projects/my-app
                    cct start --llm <target> ~/projects/my-app   on that LLM, this session only
  init            Create a project from a template. init and the five commands
                  below run the installed launcher's own commands, passing
                  every argument through.
                    cct init ml-rag ~/projects/my-rag-app
                    cct init web-dynamic ./my-app --permissions balanced
  templates       List the templates init accepts, then the add-ons it refuses
                  (the launcher's `list`; `cct list` is the feature index).
  sync            Update a project from its template. Never overwrites CLAUDE.md.
                    cct sync ~/projects/my-rag-app --dry-run   preview
                    cct sync ~/projects/my-rag-app             apply
  build           Build an approved feature unattended (auto-build):
                    cct build <feature-id> [driver args]
  permissions     Set a project's permission tier:
                    cct permissions balanced ./my-app
  playwright      Install the Playwright CLI skills into a project:
                    cct playwright ./my-app
  features        What the harness offers, from shared/features/catalog.yaml:
                  maturity, release, which adapters enforce it, and its guide.
                    cct features                     one line per feature
                    cct features --feature <id>      one in full
                    cct features --adapter pi        only what that adapter delivers
                    cct features --maturity stable   only features at that level
                    cct features --json              machine-readable
  list            Print the feature index — every feature, slash command, skill, and
                  capability, from their source-of-truth files.
                    cct list            print to the terminal
                    cct list --write    (re)generate docs/features.md
  routing         Execution-profile routing (#109). Pure — read-only:
                    cct routing validate [--config <automation.json>]
                    cct routing status
                    cct routing explain --route-class <class> [--role <role>]
                    cct routing explain --feature <id> --task <id>
                  Impure — these mutate routing state:
                    cct routing enable <profile-id>
                    cct routing tick --due --once [--wake]
  doctor          Check this machine: tools, the provider profile, the
                  repository's registries, and each installed adapter's own
                  diagnostics. Read-only; reports whether a key variable is
                  set, never its value.
                    cct doctor                   everything
                    cct doctor --adapter pi      that adapter's diagnostics only
                    cct doctor --no-network      skip provider healthchecks
                    cct doctor --json            machine-readable
  config          Inspect the configuration, without opening four files:
                    cct config validate                 run every validator
                    cct config validate --config <path> …and one automation.json
                    cct config explain <key>            what it does, its default,
                                                        the value in effect, who owns it
                    cct config explain --list           every documented key
  home            Where CCT keeps this user's files (${CCT_HOME:-~/.cct}) and
                  what is still read from the legacy ~/.code-copilot-team:
                    cct home                     show the home and any legacy entries
                    cct home migrate             move legacy entries in; never overwrites
                    cct home migrate --dry-run   preview the move
  llm             The LLM catalog (${CCT_HOME:-~/.cct}/llms.toml): named targets you
                  configure once and pick per session with --llm, so no provider
                  or model variable is ever exported in a shell.
                    cct llm list                 the targets, and whether each can launch
                    cct llm show <llm>           one llm and what each binding launches
                    cct llm validate [file]      check the catalog, by line and name
                    cct llm compatibility [<target>]
                                                 each target's state, and the evidence
                    cct llm sessions [--harness <h>] [--project <dir>]
                                                 the --llm sessions: target, model,
                                                 state, project, whether each resumes
                    cct llm test <target>        run the harness on the target once and
                                                 record what each capability did; a
                                                 --llm launch needs a passing test
                  Each takes --json.
  harness         What a harness launch would do, before it runs:
                    cct harness explain <harness> --llm <target> [--project <dir>] [--json]
                                                 what it sets and removes, by name,
                                                 and why it would be refused, from
                                                 that project (default: here)
  help            Show this help.

EXAMPLES
  cct start ~/projects/my-app  # open a harness session there
  cct start --llm deepseek .   # …on a catalog LLM, for this session only
  cct init ml-rag ~/projects/my-rag-app       # a new project from a template
  cct sync ~/projects/my-rag-app --dry-run    # what a template update would change
  cct features                 # what can this thing do?
  cct features --adapter pi    # …and what does my tool actually enforce?
  cct list                     # every command, skill and capability
  cct doctor --no-network      # quick readiness check, no provider calls
  cct config explain caps.cost_usd   # what is this setting, and what is it now?
  cct list --write             # refresh docs/features.md before a commit
  scripts/cct list | less      # from the repo root without PATH setup

DOCS
  Quick Start:    README.md#quick-start
  Feature index:  docs/features.md
  Maturity:       docs/maturity.md
  Site:           https://gosha70.github.io/code-copilot-team/
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

# installed_launcher <cct-command> — print the installed claude-code
# launcher's path, or exit 2 naming the install command. The installed
# launcher does the work; cct is the name the user types. Only an INSTALLED
# launcher qualifies: running this checkout's copy would act without the
# rules and templates setup.sh installs.
installed_launcher() {
  if command -v claude-code 2>/dev/null; then
    return 0
  elif [[ -x "$HOME/.local/bin/claude-code" ]]; then
    echo "$HOME/.local/bin/claude-code"
    return 0
  fi
  echo "cct $1: the claude-code launcher is not installed." >&2
  echo "cct $1 runs the INSTALLED launcher (~/.local/bin/claude-code), never a checkout's copy:" >&2
  echo "run from the checkout, it would act without the installed rules and templates." >&2
  echo "Run ./scripts/setup.sh --claude-code from your checkout, then retry." >&2
  return 2
}

case "$cmd" in
  start)
    launcher="$(installed_launcher start)" || exit $?
    exec "$launcher" "$@"
    ;;
  init|sync|build|permissions|playwright)
    # The launcher's own commands, under the name the user types.
    launcher="$(installed_launcher "$cmd")" || exit $?
    exec "$launcher" "$cmd" "$@"
    ;;
  templates)
    # The launcher calls this `list`; `cct list` is the feature index.
    launcher="$(installed_launcher templates)" || exit $?
    exec "$launcher" list "$@"
    ;;
  features)
    exec python3 "$SCRIPT_DIR/lib/cct_features.py" "$@"
    ;;
  list)
    # Default = print to terminal (discovery); --write regenerates the doc.
    if [[ "${1:-}" == "--write" ]]; then
      exec "$SCRIPT_DIR/generate-feature-index.sh" --write
    else
      exec "$SCRIPT_DIR/generate-feature-index.sh" --stdout
    fi
    ;;
  routing)
    exec "$SCRIPT_DIR/routing-cli.sh" "$@"
    ;;
  doctor)
    exec python3 "$SCRIPT_DIR/lib/cct_doctor.py" "$@"
    ;;
  config)
    exec python3 "$SCRIPT_DIR/lib/cct_config.py" "$@"
    ;;
  home)
    exec bash "$SCRIPT_DIR/cct-home.sh" "$@"
    ;;
  llm)
    exec bash "$SCRIPT_DIR/llm-cli.sh" "$@"
    ;;
  harness)
    exec bash "$SCRIPT_DIR/llm-cli.sh" harness "$@"
    ;;
  help|-h|--help) usage ;;
  *) echo "cct: unknown command '$cmd'" >&2; echo "Did you mean: features, list, routing, doctor, config, home, llm, harness, start, init, templates, sync, build, permissions, playwright, help?" >&2; usage >&2; exit 2 ;;
esac
