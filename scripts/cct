#!/usr/bin/env bash
# cct — unified command-line front door for code-copilot-team.
#
# One discoverable entry point for finding and validating everything the
# harness offers. Add it to PATH (or call scripts/cct) and run `cct help`.
#
#   cct start [path] [...] start a harness session (the claude-code launcher)
#   cct features [...]     what the harness offers: maturity, adapters, guides
#   cct list [--write]     browse every feature, slash command, skill, and capability
#   cct doctor [...]       is this machine ready? tools, providers, adapters
#   cct config <...>       validate the configuration, or explain one key
#   cct help               show this help
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

usage() {
  cat <<'EOF'
cct — code-copilot-team CLI

USAGE
  cct <command> [options]

COMMANDS
  start           Start a harness session in a project. Runs the installed
                  claude-code launcher (per-project cmux/tmux session, transcript
                  log, peer-review flags), so every launcher argument passes through.
                    cct start                        this directory
                    cct start ~/projects/my-app      that project
                    cct start --peer-review <name> ~/projects/my-app
  features        What the harness offers, from shared/features/catalog.yaml:
                  maturity, release, which adapters enforce it, and its guide.
                    cct features                     one line per feature
                    cct features --feature <id>      one in full
                    cct features --adapter pi        only what that adapter delivers
                    cct features --maturity stable   only features at that level
                    cct features --json              machine-readable
  list            Print the feature index — every feature, slash command, skill, and
                  capability, from their source-of-truth files.
                    cct list            print to the terminal
                    cct list --write    (re)generate docs/features.md
  routing         Execution-profile routing (#109). Pure — read-only:
                    cct routing validate [--config <automation.json>]
                    cct routing status
                    cct routing explain --route-class <class> [--role <role>]
                    cct routing explain --feature <id> --task <id>
                  Impure — these mutate routing state:
                    cct routing enable <profile-id>
                    cct routing tick --due --once [--wake]
  doctor          Check this machine: tools, the provider profile, the
                  repository's registries, and each installed adapter's own
                  diagnostics. Read-only; reports whether a key variable is
                  set, never its value.
                    cct doctor                   everything
                    cct doctor --adapter pi      that adapter's diagnostics only
                    cct doctor --no-network      skip provider healthchecks
                    cct doctor --json            machine-readable
  config          Inspect the configuration, without opening four files:
                    cct config validate                 run every validator
                    cct config validate --config <path> …and one automation.json
                    cct config explain <key>            what it does, its default,
                                                        the value in effect, who owns it
                    cct config explain --list           every documented key
  help            Show this help.

EXAMPLES
  cct start ~/projects/my-app  # open a harness session there
  cct features                 # what can this thing do?
  cct features --adapter pi    # …and what does my tool actually enforce?
  cct list                     # every command, skill and capability
  cct doctor --no-network      # quick readiness check, no provider calls
  cct config explain caps.cost_usd   # what is this setting, and what is it now?
  cct list --write             # refresh docs/features.md before a commit
  scripts/cct list | less      # from the repo root without PATH setup

DOCS
  Quick Start:    README.md#quick-start
  Feature index:  docs/features.md
  Maturity:       docs/maturity.md
  Site:           https://gosha70.github.io/code-copilot-team/
EOF
}

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift || true

case "$cmd" in
  start)
    # The installed launcher does the work; cct is the name the user types.
    # Only an INSTALLED launcher qualifies: running this checkout's copy
    # would open a session without the rules setup.sh installs.
    if launcher="$(command -v claude-code 2>/dev/null)"; then
      :
    elif [[ -x "$HOME/.local/bin/claude-code" ]]; then
      launcher="$HOME/.local/bin/claude-code"
    else
      echo "cct start: the claude-code launcher is not installed." >&2
      echo "cct start runs the INSTALLED launcher (~/.local/bin/claude-code), never a checkout's copy:" >&2
      echo "a session started from the checkout would run without the installed rules." >&2
      echo "Run ./scripts/setup.sh --claude-code from your checkout, then retry." >&2
      exit 2
    fi
    exec "$launcher" "$@"
    ;;
  features)
    exec python3 "$SCRIPT_DIR/lib/cct_features.py" "$@"
    ;;
  list)
    # Default = print to terminal (discovery); --write regenerates the doc.
    if [[ "${1:-}" == "--write" ]]; then
      exec "$SCRIPT_DIR/generate-feature-index.sh" --write
    else
      exec "$SCRIPT_DIR/generate-feature-index.sh" --stdout
    fi
    ;;
  routing)
    exec "$SCRIPT_DIR/routing-cli.sh" "$@"
    ;;
  doctor)
    exec python3 "$SCRIPT_DIR/lib/cct_doctor.py" "$@"
    ;;
  config)
    exec python3 "$SCRIPT_DIR/lib/cct_config.py" "$@"
    ;;
  help|-h|--help) usage ;;
  *) echo "cct: unknown command '$cmd'" >&2; echo "Did you mean: features, list, routing, doctor, config, start, help?" >&2; usage >&2; exit 2 ;;
esac
